# ------------------------------------------------------------------------------------------------------------- facts
def read(p): return open(p, encoding="utf-8", errors="replace").read()

def city_regions():
    out = {}
    for f in glob.glob(os.path.join(SCRIPTS, "managers/planet/*_regions.lua")):
        planet = os.path.basename(f).replace("_regions.lua", "")
        s = read(f)
        for n, x, y, sh, a, b, fl in re.findall(r'\{\s*"([^"]+)"\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*\{\s*(CIRCLE|RECTANGLE)\s*,\s*(-?[\d.]+)(?:\s*,\s*(-?[\d.]+))?\s*\}\s*,\s*([^}]*CITY[^}]*)\}', s):
            name = n.split(":")[-1]
            x, y, a = float(x), float(y), float(a)
            if sh == "CIRCLE":
                out[(planet, name)] = dict(x=x, y=y, r=a)
            else:
                b = float(b); cx, cy = (x + a) / 2, (y + b) / 2
                out[(planet, name)] = dict(x=cx, y=cy, r=max(abs(a - x), abs(b - y)) / 2)
    return out

def mission_cities():
    s = read(os.path.join(SCRIPTS, "managers/mission/mission_cities.lua"))
    return [dict(planet=p, name=n, x=float(x), y=float(y), r=float(r)) for p, n, x, y, r in
            re.findall(r'\{\s*"(\w+)"\s*,\s*"([^"]+)"\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*\}', s)]

def travel_points():
    s = read(os.path.join(SCRIPTS, "managers/planet/planet_manager.lua"))
    out = {}
    for m in re.finditer(r'\n(\w+)\s*=\s*\{\s*\n(?:.*?\n)*?\tplanetTravelPoints\s*=\s*\{(.*?)\n\t\}', s, re.S):
        for n, x, z, y, i, l in re.findall(r'\{name = "([^"]+)", x = (-?[\d.]+), z = (-?[\d.]+), y = (-?[\d.]+), interplanetaryTravelAllowed = (\d), incomingTravelAllowed = \d, landingRange = (\d+)', m.group(2)):
            out[(m.group(1), n)] = dict(x=float(x), z=float(z), y=float(y), inter=int(i))
    return out

def stock_loops(stock):
    f = os.path.join(SCRIPTS, "screenplays/cities", stock + ".lua")
    if not os.path.exists(f): return {}
    m = re.search(r'\n\tpatrolPoints\s*=\s*\{(.*?)\n\t\}', read(f), re.S)
    if not m: return {}
    loops = {}
    for line in m.group(1).split("\n"):
        km = re.match(r'\t\t(\w+)\s*=\s*\{(.*)\}\s*,?\s*$', line)
        if km:
            pts = [(float(a), float(b), float(c), int(d)) for a, b, c, d in re.findall(r'\{\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(\d+)', km.group(2))]
            if pts and all(p[3] == 0 for p in pts): loops[km.group(1)] = pts
    return loops

def stock_cell_npcs(stock, cell):
    """x,y of the stock NPCs spawned into a cell (so our seats keep clear of them)"""
    f = os.path.join(SCRIPTS, "screenplays/cities", stock + ".lua")
    if not os.path.exists(f): return []
    out = []
    for m in re.finditer(r'\{\s*"[^"]+"\s*,\s*\d+\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*-?[\d.]+\s*,\s*(\d+)', read(f)):
        if int(m.group(4)) == cell: out.append((float(m.group(1)), float(m.group(3))))
    for m in re.finditer(r'spawnMobile\("\w+",\s*"[^"]+",\s*\d+,\s*(-?[\d.]+),\s*(-?[\d.]+),\s*(-?[\d.]+),\s*-?[\d.]+,\s*(\d+)\)', read(f)):
        if int(m.group(4)) == cell: out.append((float(m.group(1)), float(m.group(3))))
    return out

# ------------------------------------------------------------------------------------------------------------- caches / probes
def cache(name):
    os.makedirs(CACHE_DIR, exist_ok=True)
    p = os.path.join(CACHE_DIR, name)
    data = json.load(open(p)) if os.path.exists(p) else {}
    def save(): json.dump(data, open(p, "w"), indent=0)
    return data, save

def lotsurvey(*args):
    return subprocess.run([os.path.join(HERE, "lotsurvey"), *args], capture_output=True, text=True).stdout

def cantina_building(planet, cx, cy, r):
    data, save = cache("cantinas.json")
    k = f"{planet}:{int(cx)}:{int(cy)}"
    if k not in data:
        rows = [l for l in lotsurvey("near", planet, str(int(cx)), str(int(cy)), str(int(min(r + 200, 900)))).splitlines() if "/shared_cantina_" in l]
        hit = None
        if rows:
            m = re.search(r'x=\s*(-?[\d.]+)\s+y=\s*(-?[\d.]+)\s+z=\s*(-?[\d.]+)\s+h=\s*(\d+)\s+oid=(\d+)\s+(\S+)', rows[0])
            if m:
                hit = dict(x=float(m.group(1)), y=float(m.group(2)), z=float(m.group(3)), h=int(m.group(4)), oid=int(m.group(5)), template=m.group(6))
                cells = {}
                for cm in re.finditer(r'cell (\d+) oid=(\d+)', lotsurvey("cells", planet, str(hit["x"]), str(hit["y"]))):
                    cells[int(cm.group(1))] = int(cm.group(2))
                hit["cells"] = cells
        data[k] = hit; save()
    return data[k]

def swg(*args):
    r = subprocess.run([os.path.join(HERE, "swg"), *args], capture_output=True, text=True)
    return r.stdout + r.stderr

def land_at(planet, x, y):
    data, save = cache("land.json")
    k = f"{planet}:{int(round(x))}:{int(round(y))}"
    if k not in data:
        out = swg("cmd", "--shared", f"runLuaFunction FbLabTests:landAt:{planet}:{int(round(x))}:{int(round(y))}")
        m = re.search(r'INFO land planet=\S+ x=\S+ y=\S+ inside=(\d)(?: z=(-?[\d.]+) water=(\S+) land=(\d) build=(\d))?', out)
        if not m: raise SystemExit("landAt gave nothing — is the server up with the rollout lab? " + out[-300:])
        data[k] = dict(inside=int(m.group(1)), z=float(m.group(2) or 0), water=m.group(3), land=int(m.group(4) or 0), build=int(m.group(5) or 0))
        save()
    return data[k]

def path_between(planet, x1, y1, x2, y2):
    data, save = cache("paths.json")
    k = f"{planet}:{int(x1)}:{int(y1)}:{int(x2)}:{int(y2)}"
    if k not in data:
        out = swg("cmd", "--shared", f"runLuaFunction FbLabTests:pathBetween:{planet}:{int(x1)}:{int(y1)}:{int(x2)}:{int(y2)}")
        m = re.search(r'INFO path planet=\S+ points=(\d+)(?: outdoor=(\d+) length=(\d+) endX=(-?\d+) endY=(-?\d+) short=(\d+))?', out)
        if not m: raise SystemExit("pathBetween gave nothing — is the server up with the rollout lab? " + out[-300:])
        data[k] = dict(points=int(m.group(1)), outdoor=int(m.group(2) or 0), length=int(m.group(3) or 0), short=int(m.group(6) or 9999))
        save()
    return data[k]

# ------------------------------------------------------------------------------------------------------------- geometry
def compass(deg):
    names = ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"]
    return names[int(((deg % 360) + 22.5) // 45) % 8]

def at(cx, cy, dist, bearing):
    """bearing in degrees, 0 = north (+y), 90 = east (+x)"""
    rad = math.radians(bearing)
    return cx + dist * math.sin(rad), cy + dist * math.cos(rad)

def in_other_city(regions, planet, key_region, x, y):
    for (p, n), r in regions.items():
        if p == planet and n != key_region and math.hypot(x - r["x"], y - r["y"]) < r["r"] + 60: return n
    return None

def good_land(planet, x, y, regions=None, key_region=None):
    if abs(x) > 7700 or abs(y) > 7700: return False
    l = land_at(planet, x, y)
    if not (l["inside"] and l["land"]): return False
    if regions is not None and in_other_city(regions, planet, key_region, x, y): return False
    return True

def arc_points(planet, cx, cy, radius, regions, key_region, n=4, step=25, prefer=None):
    """n land points on an arc at `radius` from the centre; tries bearings from `prefer` (deg) round the clock"""
    starts = [(prefer or 0) + k * 30 for k in range(12)]
    for b in starts:
        pts = [at(cx, cy, radius, b + i * step) for i in range(n)]
        if all(good_land(planet, x, y, regions, key_region) for x, y in pts):
            return b, pts
    return None, None

def one_point(planet, cx, cy, dist, prefer, regions=None, key_region=None):
    for k in range(12):
        b = prefer + k * 30
        x, y = at(cx, cy, dist, b)
        if good_land(planet, x, y, regions, key_region): return b, (x, y)
    return None, None

# ------------------------------------------------------------------------------------------------------------- the city file
def lua_pts(pts, z=None):
    return "{ " + ", ".join("{ %d, %s, %d }" % (round(x), ("nil" if z is None else z), round(y)) for x, y in pts) + " }"

def lua_list(items): return "{ " + ", ".join('"%s"' % i for i in items) + " }"

def build(plan, facts, existing_ambient=None, log=print):
    key, planet, label = plan["key"], plan["planet"], plan["label"]
    regions, tps = facts["regions"], facts["travel"]
    reg = regions.get((planet, plan["region"]))
    if reg is None:
        mc = [c for c in facts["mission"] if c["planet"] == planet and c["name"].lower().replace("'", "").startswith(label.lower().replace("'", "")[:6])]
        if not mc: raise SystemExit(f"{key}: no region {plan['region']} and no mission city")
        reg = dict(x=mc[0]["x"], y=mc[0]["y"], r=mc[0]["r"])
    cx, cy, R = reg["x"], reg["y"], reg["r"]
    notes = []
    tp = tps.get((planet, plan["starport"])) if plan.get("starport") else None
    starport = (tp["x"], tp["y"]) if tp else None
    plaza = LANDING.get(key) or (cx, cy)
    fac = FACTIONS.get(planet, DEFAULT_FACTIONS)
    rebel_held = plan["lean"] <= 40
    lines = []
    lines.append(f"-- tasks/cities/{planet}_{key}.lua — {label}: Phase 3.13 city data, generated by tools/citygen from the stock data and the running")
    lines.append(f"-- server (terrain, water, no-build, navmesh); every number is explicit so it can be read and moved by hand. Regenerate with")
    lines.append(f"-- `tools/citygen write {key}`; hand edits survive only if the plan in the tool is changed to match.")
    lines.append("FbCities:add {")
    lines.append(f'\tkey = "{key}", planet = "{planet}", label = "{label}", order = {plan["order"]},')
    lines.append(f'\tlean = {plan["lean"]},   -- 3.4: default Imperial %')
    lines.append(f"\tcentre = {{ {round(cx)}, {round(cy)} }}, radius = {round(R)},   -- the stock city region {plan['region']}")
    if starport:
        lines.append(f'\tstarport = {{ {round(starport[0])}, {round(starport[1])} }},   -- travel point "{plan["starport"]}"')
    lines.append(f"\tplaza = {{ {round(plaza[0])}, {round(plaza[1])} }},   -- " + ("the stock GCW landing spot" if key in LANDING else "the city centre"))
    lines.append("\tfactions = {")
    lines.append(f'\t\timperial = {{ leader = "{fac["imperial"][0]}", troops = {lua_list(fac["imperial"][1])} }},')
    lines.append(f'\t\trebel    = {{ leader = "{fac["rebel"][0]}", troops = {lua_list(fac["rebel"][1])} }},')
    lines.append("\t},")
    # patrols: the holder's squad walks a stock in-town loop, the other faction an arc outside the walls
    loops = stock_loops(plan["stock"])
    loop_key = None
    if loops:
        loop_key = "cll8_1" if "cll8_1" in loops and len(loops["cll8_1"]) >= 3 else max(loops, key=lambda k: len(loops[k]))
        if len(loops[loop_key]) < 3: loop_key = None
    town, outside = ("rebel", "imperial") if rebel_held else ("imperial", "rebel")
    arc_r = R + (150 if plan.get("outpost") else 200)
    prefer = (math.degrees(math.atan2(cx - starport[0], cy - starport[1])) if starport else 0)   # the far side from the starport
    b, arc = arc_points(planet, cx, cy, arc_r, regions, plan["region"], prefer=prefer)
    lines.append("\tpatrols = {   -- 3.2: one squad per faction; the holder walks a stock in-town loop, the other side a loop outside the walls")
    if loop_key:
        pts = loops[loop_key]
        lines.append(f"\t\t{town} = {{ points = {{ " + ", ".join("{ %d, %g, %d }" % (round(x), z, round(y)) for x, z, y, c in pts) + f" }} }},   -- the stock walking loop {loop_key} of cities/{plan['stock']}.lua")
    else:
        notes.append("no stock walking loop: the in-town squad is missing")
    if arc:
        lines.append(f"\t\t{outside} = {{ points = {lua_pts(arc)} }},   -- open ground {round(arc_r)} m out, bearing {round(b) % 360}° ({compass(b)}), land-checked")
    else:
        notes.append("no land arc found outside the walls")
    lines.append("\t},")
    # convoy
    if starport and tp["inter"] == 1 and not plan.get("outpost"):
        pb = path_between(planet, starport[0], starport[1], plaza[0], plaza[1])
        if pb["points"] >= 2 and pb["short"] <= 60:
            lines.append(f"\tconvoy = {{ from = {{ {round(starport[0])}, {round(starport[1])} }}, to = {{ {round(plaza[0])}, {round(plaza[1])} }} }},   -- 3.11: navmesh route starport -> plaza ({pb['length']} m, {pb['points']} path points)")
        else:
            notes.append(f"convoy route starport->plaza not on the navmesh (points={pb['points']} short={pb['short']} m): no convoy")
    # relays
    relays = []
    if starport:
        bear = math.degrees(math.atan2(cx - starport[0], cy - starport[1]))
        for d in (22, 30, 40):
            rx, ry = at(starport[0], starport[1], d, bear)
            if good_land(planet, rx, ry):
                relays.append(f'\t\t{{ key = "starport", label = "{label} {"Shuttle" if tp["inter"] == 0 else "Starport"}", x = {round(rx)}, y = {round(ry)}, dir = {round(((bear + 180) % 360) / 60) % 6}, cell = 0 }},   -- {d} m from the pad toward town')
                break
        else:
            notes.append("no land spot for the starport relay")
    cantina = None
    layout = None
    if plan.get("cantina"):
        cantina = cantina_building(planet, cx, cy, R)
        if cantina:
            shell = cantina["template"].split("/")[-1].replace(".iff", "")
            layout = SHELL_LAYOUT.get(shell)
            cell = cantina["cells"].get(3, cantina["oid"] + 3)
            if layout:
                rx, rz, ry, rdir = SEATS[layout]["relay"]
                relays.append(f'\t\t{{ key = "cantina", label = "{label} Cantina", x = {rx}, z = {rz}, y = {ry}, dir = {rdir}, cell = {cell} }},   -- main room of {shell} (building {cantina["oid"]})')
            else:
                notes.append(f"cantina shell {shell} has no seat preset")
        else:
            notes.append("no cantina shell found in the snapshot")
    if relays:
        lines.append("\trelays = {   -- 3.10: HoloNet relay droids")
        lines.extend(relays)
        lines.append("\t},")
    # ambient
    if existing_ambient:
        lines.append(existing_ambient.rstrip(",") + ",")
    elif cantina and layout and planet in VOICES:
        v = VOICES[planet]
        cell = cantina["cells"].get(3, cantina["oid"] + 3)
        stock_npcs = stock_cell_npcs(plan["stock"], cell)
        seats = []
        for sx, sy, sdir in SEATS[layout]["seats"]:
            clash = [n for n in stock_npcs if math.hypot(n[0] - sx, n[1] - sy) < 1.3]
            if clash:
                notes.append(f"seat {sx},{sy} is within 1.3 m of a stock NPC in cell {cell}: dropped")
                continue
            seats.append((sx, sy, sdir))
        ax, az, ay = SEATS[layout]["anchor"]
        lines.append(f"\tambient = {{   -- 3.7/3.8: the living layer in the cantina (seat preset {layout}, voice {planet})")
        lines.append("\t\t{")
        lines.append(f'\t\t\tkey = "cantina", label = "{label} Cantina",')
        lines.append(f"\t\t\tanchor = {{ x = {ax}, z = {az}, y = {ay}, cell = {cell} }},")
        lines.append("\t\t\tseats = {")
        for sx, sy, sdir in seats:
            lines.append(f"\t\t\t\t{{ x = {sx}, z = -0.9, y = {sy}, dir = {sdir}, cell = {cell} }},")
        lines.append("\t\t\t},")
        lines.append(f"\t\t\ttemplates = {lua_list(v['templates'])},")
        lines.append(f"\t\t\tmoods = {lua_list(v['moods'])},")
        lines.append("\t\t\tchatter = {")
        for l in v["chatter"]: lines.append('\t\t\t\t"%s",' % l.replace("{city}", label).replace('"', "'"))
        lines.append("\t\t\t},")
        lines.append("\t\t\tnewcomer = {")
        for l in v["newcomer"]: lines.append('\t\t\t\t"%s",' % l.replace("{city}", label).replace('"', "'"))
        lines.append("\t\t\t},")
        lines.append(f"\t\t\temotes = {lua_list(v['emotes'])},")
        lines.append("\t\t},")
        lines.append("\t},")
    # invasion
    if plan.get("invasion"):
        defender = "imperial" if plan["lean"] >= 50 else "rebel"
        attacker = "rebel" if defender == "imperial" else "imperial"
        sb, staging = one_point(planet, cx, cy, R + 400, prefer, regions, plan["region"])
        if staging:
            att, deff = INVADERS[attacker], GARRISON[defender]
            w = dict(label=label, att="Rebel" if attacker == "rebel" else "Imperial", attp="Rebels" if attacker == "rebel" else "Imperials",
                     **{"def": "Imperial" if defender == "imperial" else "Rebel"}, other="The Empire" if defender == "imperial" else "The Alliance", where=compass(sb))
            lines.append("\tinvasion = {   -- 3.1: the GCW invasion (a contested city; the city key is its territory region)")
            lines.append(f'\t\tdefender = "{defender}", attacker = "{attacker}",')
            lines.append(f"\t\tstaging = {{ {round(staging[0])}, {round(staging[1])} }},   -- {round(R + 400)} m {compass(sb)} of the centre, land-checked")
            lines.append(f"\t\tplaza = {{ {round(plaza[0])}, {round(plaza[1])} }},")
            lines.append(f"\t\tmuster = {{ {round(plaza[0] + 5)}, {round(plaza[1] - 18)} }},")
            lines.append(f'\t\tattackers = {{ leader = "{att[0]}", troops = {lua_list(att[1])} }},')
            lines.append(f'\t\tdefenders = {{ leader = "{deff[0]}", troops = {lua_list(deff[1])} }},')
            for k in ("warn", "assault", "held", "fell", "withdrew"):
                lines.append(f'\t\t{k} = "{INVASION_TEXT[k].format(**w)}",')
            lines.append("\t\tnews = {")
            for k in ("held", "fell", "withdrew"):
                lines.append(f'\t\t\t{k} = "{INVASION_TEXT["news_" + k].format(**w)}",')
            lines.append("\t\t},")
            lines.append("\t},")
        else:
            notes.append("no land staging ground: no invasion")
    lines.append("}")
    if notes:
        lines.append("-- citygen notes: " + "; ".join(notes))
    return "\n".join(lines) + "\n", notes

def existing_ambient_block(path):
    if not os.path.exists(path): return None
    s = read(path)
    i = s.find("\tambient = {")
    if i < 0: return None
    depth, j, in_str = 0, i, None
    while j < len(s):
        ch = s[j]
        if in_str:
            if ch == "\\": j += 2; continue
            if ch == in_str: in_str = None
        elif s.startswith("--", j):
            j = s.find("\n", j); continue
        elif ch in "\"'": in_str = ch
        elif ch == "{": depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0: return s[i:j + 1]
        j += 1
    return None

# ------------------------------------------------------------------------------------------------------------- commands
def cmd_plan():
    for p in PLAN:
        print("%-28s %-10s lean=%-3d %s%s%s%s" % (p["key"], p["planet"], p["lean"], "starport " if p.get("starport") else "", "cantina " if p.get("cantina") else "",
                                                   "invasion " if p.get("invasion") else "", "outpost" if p.get("outpost") else ""))

def cmd_write(keys, dry):
    facts = dict(regions=city_regions(), mission=mission_cities(), travel=travel_points())
    os.makedirs(CITIES_DIR, exist_ok=True)
    for p in PLAN:
        if keys and p["key"] not in keys: continue
        path = os.path.join(CITIES_DIR, f"{p['planet']}_{p['key']}.lua")
        amb = existing_ambient_block(path) if p.get("keep_ambient") else None
        text, notes = build(p, facts, existing_ambient=amb)
        if dry:
            print(f"==== {path}\n{text}")
        else:
            open(path, "w").write(text)
            print(f"wrote {os.path.relpath(path, REPO)}" + (f"   notes: {'; '.join(notes)}" if notes else ""))

def cmd_spots(planet, x, y, r):
    for b in range(0, 360, 30):
        px, py = at(x, y, r, b)
        l = land_at(planet, px, py)
        print("%3d° %-10s x=%6d y=%6d z=%7.1f water=%-6s land=%d build=%d" % (b, compass(b), round(px), round(py), l["z"], l["water"], l["land"], l["build"]))

def main(argv):
    if not argv or argv[0] in ("-h", "--help"): print(__doc__); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "plan": cmd_plan()
    elif cmd == "write": cmd_write([a for a in rest if not a.startswith("--")], "--dry" in rest)
    elif cmd == "spots": cmd_spots(rest[0], float(rest[1]), float(rest[2]), float(rest[3]) if len(rest) > 3 else 300)
    else: print(__doc__); return 2
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
