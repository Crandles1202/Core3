PREVIEW_DIR = os.path.join(SITES_DIR, ".preview")   # outside the loader's *.lua glob; git-ignored


def swg_lua(call, timeout=8, shared=False):
    """Lines a lab oracle printed (runLuaFunction FbLabTests:<call>) on the running server; [] when it is down.
    shared=True for read-only oracles: they run without taking the bench lock (another agent may be testing)."""
    try:
        res = subprocess.run([os.path.join(HERE, "swg"), "cmd"] + (["--shared"] if shared else []) + ["runLuaFunction FbLabTests:" + call, "--timeout", str(timeout)],
                             capture_output=True, text=True, timeout=timeout + 25)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [l for l in res.stdout.splitlines() if re.match(r"(INFO|ERROR|FAIL|WARN|PASS) ", l)]


def write_preview(lua):
    if not re.search(r"^FbSites:add \{", lua or "", re.M):
        return None, "not a site file"
    os.makedirs(PREVIEW_DIR, exist_ok=True)
    out = os.path.join(PREVIEW_DIR, "preview.lua")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(lua if lua.endswith("\n") else lua + "\n")
    return out, None


def furniture_check(template, path):
    """tools/lotsurvey check: every tenant spot in the file against the client-only furniture."""
    try:
        res = subprocess.run([os.path.join(HERE, "lotsurvey"), "check", template, "--lua", path], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        return ["ERROR furniture check did not run: %s" % e]
    return [l for l in res.stdout.splitlines() if re.match(r"(FAIL|WARN|summary|OK)", l)] or [l for l in res.stderr.splitlines()[-3:]]


def preview_site(lua, template):
    """Push the draft into the running server (FbSites:preview via the lab), then audit it."""
    path, err = write_preview(lua)
    if err:
        return dict(ok=False, lines=["ERROR " + err])
    lines = swg_lua("sitePreview:preview", 20)
    if not lines:
        return dict(ok=False, lines=["ERROR the game server did not answer (tools/swg status)"])
    m = re.search(r'name = "([a-z0-9_]+)"', lua)
    if m and any(l.startswith("INFO sitePreview") for l in lines):
        lines += swg_lua("sitePlacement:" + m.group(1), 20)
    if template:
        lines += furniture_check(template, path)
    ok = any(l.startswith("INFO sitePreview") for l in lines) and not any(l.startswith(("ERROR", "FAIL")) for l in lines)
    return dict(ok=ok, lines=lines)


def check_site(lua, template):
    """Lab checks without spawning: furniture (offline) plus, when the preview of this site is up, its placement audit."""
    path, err = write_preview(lua)
    if err:
        return dict(ok=False, lines=["ERROR " + err])
    lines = furniture_check(template, path) if template else []
    m = re.search(r'name = "([a-z0-9_]+)"', lua)
    if m:
        lines += swg_lua("sitePlacement:" + m.group(1), 20, shared=True) or ["INFO placement: the game server is not up, or this site is not spawned (Spawn preview first)"]
    ok = not any(l.startswith(("ERROR", "FAIL")) for l in lines)
    return dict(ok=ok, lines=lines)


def teleport(char, planet, x, y):
    if not re.fullmatch(r"[A-Za-z][A-Za-z' -]{0,39}", char or "") or not re.fullmatch(r"[a-z0-9_]{1,20}", planet or ""):
        return dict(ok=False, lines=["ERROR give your character's first name (Site panel) and a planet"])
    try:
        x, y = float(x), float(y)
    except (TypeError, ValueError):
        return dict(ok=False, lines=["ERROR bad coordinates"])
    lines = swg_lua("travel:%s:%s:%.1f:%.1f" % (char, planet, x, y), 10)
    return dict(ok=any(l.startswith("INFO travel") for l in lines), lines=lines or ["ERROR the game server did not answer, or %s is not online" % char])


