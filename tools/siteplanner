    npcs = npc_templates()
    assert any(n["template"] == "fb_parts_dealer" for n in npcs), "npc list"
    assert os.path.exists(os.path.join(UI_DIR, "index.html")), "ui page"
    print("siteplanner selftest: %d buildings (%d stock npcs indoors, %d outdoors, %d objects indoors) in the Mos Eisley area, %d shells, %d sites, %d npc templates — ok" % (
