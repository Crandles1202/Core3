           dict(op="add", oid=10000064, template="object/building/tatooine/shared_filler_building_block_64x16_style_02.iff", x=3700.0, y=-4700.0, z=6.0, heading=45)]
    blob, results = we.patched_snapshot(d.vfs, "tatooine", ops)
    assert not any(m.startswith("ERROR") for _, m in results), results
    edited = {n["oid"]: n for n in ls.read_snapshot(d.vfs, "tatooine", data=blob)}
    assert abs(edited[bank["oid"]]["x"] - 3510.0) < 0.01 and abs(edited[bank["oid"]]["heading"] - 90) < 0.5, "moved bank"
    assert filler["oid"] not in edited, "deleted filler"
    assert edited[10000064]["name"].endswith("style_02.iff") and abs(edited[10000064]["heading"] - 45) < 0.5, "added filler"
    assert len(edited) == len(stock), "one deleted, one added: same node count"
    assert any(c["template"].endswith("shared_filler_building_block_64x16_style_01.iff") and c["count"] >= 20 for c in d.catalog()), "catalog lists the filler blocks"
    assert any(c.get("prop") and "terminal_bazaar" in c["template"] for c in d.catalog()), "catalog lists the bazaar terminals"
    assert all("oid" in p for p in area["props"]), "props carry their snapshot oid"
    png = map_image(d.vfs, "tatooine")
    assert png and png[:8] == b"\x89PNG\r\n\x1a\n" and struct.unpack(">II", png[16:24]) == (1024, 1024), "planet map png"
    pth, err = write_preview(open(os.path.join(SITES_DIR, "mos_eisley_trade_hall.lua")).read())
    assert pth and not err and os.path.exists(pth) and all(".preview" not in s["file"] for s in load_sites()), "preview file outside the site list"
    assert any(l.startswith("summary spots=11 fail=0") for l in furniture_check("object/building/tatooine/shared_guild_commerce_tatooine_style_01.iff", pth)), "furniture check through the planner"
    sp = next((b for b in area["buildings"] if b["short"] == "starport_tatooine"), None)
    assert sp and any(o["kind"] == "terminal" for o in sp["objects"]), "starport terminals from the snapshot"
    spsh = next((x for x in shells if x["short"] == "starport_tatooine"), None)
