MAPS_DIR = os.path.join(os.path.expanduser("~"), ".swg-lab", "maps")


# ---------------------------------------------------------------- the in-game planet map (texture/ui_map_<planet>.dds, DXT1)

def dxt1_decode(data, width, height):
    """DXT1 blocks -> list of rows of (r, g, b). Pure Python; a 1024² map takes a few seconds, once, then it is cached."""
    px = [[(0, 0, 0)] * width for _ in range(height)]
    bw = width // 4
    pos = 0
    for by in range(height // 4):
        for bx in range(bw):
            c0, c1, bits = struct.unpack_from("<HHI", data, pos)
            pos += 8
            r0, g0, b0 = (c0 >> 11) * 255 // 31, ((c0 >> 5) & 63) * 255 // 63, (c0 & 31) * 255 // 31
            r1, g1, b1 = (c1 >> 11) * 255 // 31, ((c1 >> 5) & 63) * 255 // 63, (c1 & 31) * 255 // 31
            if c0 > c1:
                pal = ((r0, g0, b0), (r1, g1, b1), ((2 * r0 + r1) // 3, (2 * g0 + g1) // 3, (2 * b0 + b1) // 3), ((r0 + 2 * r1) // 3, (g0 + 2 * g1) // 3, (b0 + 2 * b1) // 3))
            else:
                pal = ((r0, g0, b0), (r1, g1, b1), ((r0 + r1) // 2, (g0 + g1) // 2, (b0 + b1) // 2), (0, 0, 0))
            for j in range(4):
                row = px[by * 4 + j]
                for i in range(4):
                    row[bx * 4 + i] = pal[(bits >> (2 * (j * 4 + i))) & 3]
    return px


def png_encode(rows):
    """Rows of (r, g, b) -> PNG bytes (stdlib only)."""
    import zlib
    h, w = len(rows), len(rows[0])
    raw = b"".join(b"\x00" + bytes(v for p in row for v in p) for row in rows)

    def chunk(tag, body):
        c = struct.pack(">I", len(body)) + tag + body
        return c + struct.pack(">I", zlib.crc32(tag + body) & 0xffffffff)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b"")


def map_image(vfs, planet):
    """PNG of the planet map the game shows in its map window (1024², the whole zone), cached in ~/.swg-lab/maps/."""
    if planet not in we.PLANETS:
        return None
    os.makedirs(MAPS_DIR, exist_ok=True)
    out = os.path.join(MAPS_DIR, planet + ".png")
    if not os.path.exists(out):
        try:
            d = vfs.read("texture/ui_map_%s.dds" % planet)
        except FileNotFoundError:
            return None
        if d[:4] != b"DDS " or d[84:88] != b"DXT1":
            return None
        height, width = struct.unpack_from("<II", d, 12)
        rows = dxt1_decode(d[128:], width, height)
        with open(out, "wb") as fh:
            fh.write(png_encode(rows))
    with open(out, "rb") as fh:
        return fh.read()


def terrain_grid(planet, x, y, r, step):
    """Heights of the square around (x, y) every step m, from the running server (FbLabTests:terrainGrid) and cached
    on disk — terrain never changes. {x0, y0, step, cols, rows, min, max, h: [row-major, south to north]} or an error."""
    if planet not in we.PLANETS:
        return dict(error="unknown planet")
    step = max(1, min(32, int(step)))
    r = max(50, min(2000, int(r)))
    x0, y0 = int(round((x - r) / step) * step), int(round((y - r) / step) * step)
    x1, y1 = x0 + int(2 * r / step) * step, y0 + int(2 * r / step) * step
    if ((x1 - x0) // step + 1) ** 2 > 160000:
        return dict(error="too many points: a coarser step or a smaller radius")
    os.makedirs(TERRAIN_DIR, exist_ok=True)
    path = os.path.join(TERRAIN_DIR, "%s_%d_%d_%d_%d_%d.txt" % (planet, x0, y0, x1, y1, step))
    if not os.path.exists(path):
        lines = swg_lua("terrainGrid:%s:%d:%d:%d:%d:%d:%s" % (planet, x0, y0, x1, y1, step, path), 90, shared=True)
        if not any(l.startswith("INFO terrainGrid") for l in lines):
            return dict(error=(lines[0] if lines else "the game server did not answer (terrain needs tools/swg start)"))
    with open(path, encoding="utf-8") as fh:
        head = fh.readline().split()
        cols, rows = int(head[6]), int(head[7])
        h = []
        for line in fh:
            h.extend(float(v) for v in line.split())
    if len(h) != cols * rows:
        os.remove(path)
        return dict(error="corrupt grid file removed; ask again")
    return dict(planet=planet, x0=x0, y0=y0, step=step, cols=cols, rows=rows, min=min(h), max=max(h), h=h)


TILE = 128   # points per tile side; a tile is one console call (~1 s at most on the main thread)


def terrain_tile(planet, step, tx, ty):
    """One tile of the height field: TILE×TILE points every step m, tile (tx, ty) covering x from tx*TILE*step. Cached on disk."""
    if planet not in we.PLANETS or step not in (1, 2, 4, 8, 16, 32):
        return dict(error="bad tile request")
    span = TILE * step
    x0, y0 = tx * span, ty * span
    if abs(x0) > 9000 or abs(y0) > 9000:
        return dict(error="outside the planet")
    x1, y1 = x0 + (TILE - 1) * step, y0 + (TILE - 1) * step
    os.makedirs(TERRAIN_DIR, exist_ok=True)
    path = os.path.join(TERRAIN_DIR, "%s_t%d_%d_%d.txt" % (planet, step, tx, ty))
    if not os.path.exists(path):
        lines = swg_lua("terrainGrid:%s:%d:%d:%d:%d:%d:%s" % (planet, x0, y0, x1, y1, step, path), 60, shared=True)
        if not any(l.startswith("INFO terrainGrid") for l in lines):
            return dict(error=(lines[0] if lines else "the game server did not answer (terrain needs tools/swg start)"))
    with open(path, encoding="utf-8") as fh:
        head = fh.readline().split()
        cols, rows = int(head[6]), int(head[7])
        h = []
        for line in fh:
            h.extend(float(v) for v in line.split())
    if len(h) != cols * rows:
        os.remove(path)
        return dict(error="corrupt tile removed; ask again")
    return dict(planet=planet, x0=x0, y0=y0, step=step, cols=cols, rows=rows, min=min(h), max=max(h), h=h, tx=tx, ty=ty)


def save_site(name, lua, force):
    name = re.sub(r"[^a-z0-9_]", "_", name.lower())
    if not name:
        return False, "empty name"
    if not re.search(r"^FbSites:add \{", lua, re.M):
        return False, "not a site file"
    os.makedirs(SITES_DIR, exist_ok=True)
    out = os.path.join(SITES_DIR, name + ".lua")
    if os.path.exists(out) and not force:
        return False, "%s exists (save again with overwrite)" % out
    lua = re.sub(r'name = "[^"]*"', 'name = "%s"' % name, lua, count=1)
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(lua if lua.endswith("\n") else lua + "\n")
    return True, out


# ---------------------------------------------------------------- http

class Handler(BaseHTTPRequestHandler):
    data = None

    def log_message(self, fmt, *args):
        sys.stderr.write("siteplanner: " + (fmt % args) + "\n")

    def _bytes(self, body, ctype, code=200):
        try:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "max-age=86400")
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode("utf-8")
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass   # the browser gave up on this request (clicked on, reloaded): nothing to report

    def handle(self):
        try:
            super().handle()
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = dict(urllib.parse.parse_qsl(u.query))
        try:
            if u.path in ("/", "/index.html"):
                with open(os.path.join(UI_DIR, "index.html"), "rb") as fh:
                    body = fh.read()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif u.path == "/api/area":
                self._json(self.data.area(q.get("planet", "tatooine"), float(q.get("x", 3520)), float(q.get("y", -4810)), float(q.get("r", 250))))
            elif u.path == "/api/shells":
                self._json(self.data.shells())
            elif u.path == "/api/places":
                self._json(places(q.get("planet", "tatooine")))
            elif u.path == "/api/sites":
                self._json(load_sites())
            elif u.path == "/api/npcs":
                self._json(npc_templates())
            elif u.path == "/api/mapimage":
                png = map_image(self.data.vfs, q.get("planet", "tatooine"))
                if png is None:
                    self._json(dict(error="no map texture for that planet"), 404)
                else:
                    self._bytes(png, "image/png")
            elif u.path == "/api/terraintile":
                self._json(terrain_tile(q.get("planet", "tatooine"), int(q.get("step", 4)), int(q.get("tx", 0)), int(q.get("ty", 0))))
            elif u.path == "/api/terraingrid":
                self._json(terrain_grid(q.get("planet", "tatooine"), float(q.get("x", 0)), float(q.get("y", 0)), float(q.get("r", 300)), int(q.get("step", 4))))
            elif u.path == "/api/world":
                self._json(self.data.world(q.get("planet", "tatooine")))
            elif u.path == "/api/catalog":
                self._json(self.data.catalog())
            elif u.path == "/api/terrain":
                self._json(terrain_heights(q.get("planet", "tatooine"), q.get("pts", "")))
            elif u.path == "/api/live":
                self._json(live_npcs(q.get("filter", "")))
            else:
                self._json(dict(error="not found"), 404)
        except FileNotFoundError as e:
            self._json(dict(error="no data: %s" % e), 404)

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        n = int(self.headers.get("Content-Length", "0"))
        body = json.loads(self.rfile.read(n) or b"{}")
        if u.path == "/api/save":
            ok, msg = save_site(body.get("name", ""), body.get("lua", ""), bool(body.get("force")))
            self._json(dict(ok=ok, message=msg), 200 if ok else 400)
        elif u.path == "/api/preview":
            self._json(preview_site(body.get("lua", ""), body.get("template", "")))
        elif u.path == "/api/preview/end":
            lines = swg_lua("sitePreviewEnd", 20)
            self._json(dict(ok=bool(lines) and not any(l.startswith("ERROR") for l in lines), lines=lines or ["ERROR the game server did not answer"]))
        elif u.path == "/api/check":
            self._json(check_site(body.get("lua", ""), body.get("template", "")))
        elif u.path == "/api/world/save":
            planet = body.get("planet", "")
            if planet not in we.PLANETS:
                self._json(dict(ok=False, message="unknown planet"), 400)
            else:
                ops = [o for o in body.get("ops", []) if o.get("op") in ("move", "delete", "add")]
                saved = we.save_edits(planet, ops)
                try:
                    blob, results = we.patched_snapshot(self.data.vfs, planet, saved)
                    errors = [m for _, m in results if m.startswith("ERROR")]
                except Exception as e:   # a bad op must not take the server down
                    errors = ["ERROR %s" % e]
                we.write_lua_twin()
                self._json(dict(ok=not errors, message=("%d edit(s) saved to tre-src/world/%s.json" % (len(saved), planet)) + ("" if not errors else "; " + "; ".join(errors)), ops=saved))
        elif u.path == "/api/clientlog":
            sys.stderr.write("siteplanner: page reports: %s\n" % str(body.get("text", ""))[:2000])
            self._json(dict(ok=True))
        elif u.path == "/api/teleport":
            self._json(teleport(body.get("char", ""), body.get("planet", ""), body.get("x"), body.get("y")))
        else:
            self._json(dict(error="not found"), 404)


def open_browser(port):
    """A browser inside WSL (WSLg shows it on the Windows desktop): Windows -> WSL TCP loopback is blocked
    on this machine (see docs/dev-notes.md 2026-10-19), so the page is opened from the Linux side."""
    for exe in ("firefox-esr", "firefox", "chromium", "xdg-open"):
        path = subprocess.run(["which", exe], capture_output=True, text=True).stdout.strip()
        if path:
            env = dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0"), WAYLAND_DISPLAY=os.environ.get("WAYLAND_DISPLAY", "wayland-0"), MOZ_ENABLE_WAYLAND="1")
            subprocess.Popen([path, "http://127.0.0.1:%d/" % port], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            print("site planner: opened in %s (WSLg)" % exe)
            return True
    print("site planner: no browser in WSL (sudo apt-get install firefox-esr) — open http://localhost:%d/ yourself" % port)
    return False


def cmd_serve(a):
    Handler.data = Data()
    # warm the slow data in the background so the first page load does not wait ~15 s on the archives
    import threading
    def warm():
        try:
            Handler.data.shells()
            Handler.data.snapshot("tatooine")
            Handler.data.catalog()
            print("site planner: catalogue ready")
        except Exception as e:   # noqa: BLE001 — a warm-up failure only costs the first visitor time
            print("site planner: warm-up failed: %s" % e)
    threading.Thread(target=warm, daemon=True).start()
    if a.browser:
        open_browser(a.port)
    try:
        srv = DualStackServer((a.host, a.port), Handler) if ":" in a.host else ThreadingHTTPServer((a.host, a.port), Handler)
    except OSError as e:
        if e.errno == 98:
            print("site planner: port %d is already in use — it is probably running already: open http://localhost:%d/  (or: tmux attach -t planner; another port: --port N)" % (a.port, a.port))
            return 0
        raise
    print("site planner: http://localhost:%d/  (Ctrl+C to stop; sites are written to %s)" % (a.port, SITES_DIR))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


