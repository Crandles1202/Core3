#!/usr/bin/env python3
"""
tools/citizens/citizen — the citizens' accounts, characters and directory (Phase 7.2, Final Boss).

  citizen new <citizen> [--no-veteran]      account (swg account create <account> 0, password in ~/.swg-lab) if
                                            missing, the character through the bot client, then the veteran start:
                                            each skill box of the persona's "## Character" section awarded by the lab
                                            while the character is online (a seat is started and stopped for it)
  citizen status <citizen>                  account, character, skills on the server (needs the server up)
  citizen list                              every persona in tools/citizens/cast/ and whether it has a character
  citizen outfit <citizen> [--keep]         hand the character the gear its profession needs (weapon in hand, survey
                                            tool, harvester deeds + wind energy, medpacks); seats it for the hand-over
                                            unless a seat is up (--keep leaves the seat it started running). Idempotent
  citizen directory                         prints tools/citizens/directory.json (what pilots use to find each other)

The persona file (tools/citizens/cast/<citizen>.md) must carry a "## Character" section of key: value lines:
  account: teyla-vosk                  the login (one account per citizen: a real player, not an NPC)
  name: Teyla Vosk                     first and last name (checked against the name filter at creation)
  race: object/creature/player/human_female.iff
  profession: combat_marksman          the starting profession template
  veteran: combat_marksman_master, combat_rifleman_accuracy_02, ...   skill boxes to award (prerequisites follow)
  faction: rebel | imperial | neutral
  home: tatooine 3520 -4800            planet and a spot the citizen calls home
  sells: composite armour, ...         optional, for the directory

Rules: a non-admin account may create one character per hour (a declined name does not count), and the galaxy
name filter refuses canon names. Creating an account is a DB write outside the lab accounts: Chuck's call.
"""
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
TOOLS = os.path.dirname(HERE)
CAST_DIR = os.path.join(HERE, "cast")
DIRECTORY = os.path.join(HERE, "directory.json")
LABDIR = os.environ.get("SWG_LABDIR", os.path.expanduser("~/.swg-lab"))
SWG = os.path.join(TOOLS, "swg")
SEAT = os.path.join(TOOLS, "seat")


def die(msg, code=1):
    print(f"citizen: {msg}", file=sys.stderr)
    sys.exit(code)


# login port per server instance (SWG_INSTANCE): the bench, the live instance (+1000), the second bench (+2000);
# an explicit SWG_LOGIN_PORT wins (same table as tools/seat and crew).
INSTANCE_PORTS = {"bench": "44453", "live": "45453", "bench2": "46453"}


def login_port():
    inst = os.environ.get("SWG_INSTANCE", "").strip().lower() or "bench"
    if inst not in INSTANCE_PORTS:
        die(f"unknown SWG_INSTANCE '{inst}' (one of {', '.join(INSTANCE_PORTS)})")
    return os.environ.get("SWG_LOGIN_PORT") or INSTANCE_PORTS[inst]


def bench_bin():
    out = subprocess.run(["git", "-C", TOOLS, "worktree", "list", "--porcelain"], capture_output=True, text=True).stdout
    first = out.splitlines()[0] if out else ""
    root = first[len("worktree "):] if first.startswith("worktree ") else os.path.dirname(TOOLS)
    return os.path.join(root, "MMOCoreORB", "bin")


def character_section(citizen):
    path = os.path.join(CAST_DIR, f"{citizen}.md")
    if not os.path.exists(path):
        die(f"no persona at {path}")
    text = open(path).read()
    m = re.search(r"^## Character\s*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    if not m:
        die(f"{path} has no '## Character' section (see citizen --help)")
    fields = {}
    for line in m.group(1).splitlines():
        line = line.strip().lstrip("-* ")
        if ":" in line and not line.startswith("#"):
            k, v = line.split(":", 1)
            fields[k.strip().lower()] = v.strip()
    for key in ("account", "name", "race", "profession"):
        if key not in fields:
            die(f"{path}: '## Character' lacks '{key}:'")
    fields["first"] = fields["name"].split()[0]
    fields["veteran_list"] = [s.strip() for s in fields.get("veteran", "").split(",") if s.strip()]
    return fields


def mysql(query):
    return subprocess.run(["mysql", "-N", "swgemu", "-e", query], capture_output=True, text=True).stdout.strip()


def account_exists(user):
    return mysql(f"SELECT account_id FROM accounts WHERE username='{user}'") != ""


def character_exists(first):
    # a new character sits in characters_dirty until the server's next commit (console `save`); the login
    # server only lists rows of `characters`
    return mysql(f"SELECT character_oid FROM characters WHERE firstname='{first}'") != ""


def character_pending(first):
    return mysql(f"SELECT character_oid FROM characters_dirty WHERE firstname='{first}'") != ""


def commit_characters(first, timeout=120):
    """Ask the server to save so the characters table gets the new row; wait for it."""
    subprocess.run([SWG, "cmd", "save", "--timeout", "10"], capture_output=True, text=True)
    for _ in range(timeout):
        if character_exists(first):
            return True
        time.sleep(1)
    return False


def lab(fn, timeout=15):
    out = subprocess.run([SWG, "cmd", f"runLuaFunction FbLabTests:{fn}", "--timeout", str(timeout)], capture_output=True, text=True).stdout
    return [l for l in out.splitlines() if l.startswith(("INFO", "ERROR"))]


def cmd_new(args):
    citizen = args[0]
    veteran = "--no-veteran" not in args
    f = character_section(citizen)
    account, first = f["account"], f["first"]

    # 1. the account
    passfile = os.path.join(LABDIR, f"{account}.pass")
    if account_exists(account):
        if not os.path.exists(passfile):
            die(f"account {account} exists but {passfile} is missing: swg account create {account} 0 --reset")
        print(f"account {account}: exists")
    else:
        r = subprocess.run([SWG, "account", "create", account, "0"], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"swg account create failed: {r.stdout}{r.stderr}")
        print(f"account {account}: created (password in {passfile})")

    # 2. the character
    if character_exists(first):
        print(f"character {f['name']}: exists")
    elif character_pending(first):
        print(f"character {f['name']}: created earlier, waiting for the server to commit it (save)")
        if not commit_characters(first):
            die("the characters table never got the row (is the server up?)")
    else:
        client = os.path.join(bench_bin(), "core3client")
        env = dict(os.environ, CORE3_CLIENT_PASSWORD=open(passfile).read().strip())
        log = os.path.join(LABDIR, f"citizen-{citizen}.create.log")
        argv = [client, "--username", account, "--login-host", os.environ.get("SWG_LOGIN_HOST", "127.0.0.1"),
                "--login-port", login_port(),
                "--create-character", "--char-name", f["name"], "--char-race", f["race"], "--char-profession", f["profession"],
                "--wait", "3"]
        if f.get("hair"):
            argv += ["--char-hair-template", f["hair"]]
        with open(log, "wb") as lf:
            r = subprocess.run(argv, cwd=bench_bin(), env=env, stdout=lf, stderr=subprocess.STDOUT)
        created = "Character creation SUCCESS" in open(log, errors="replace").read()
        if r.returncode != 0 or not created:
            tail = subprocess.run(["tail", "-n", "15", log], capture_output=True, text=True).stdout
            die(f"character creation failed (exit {r.returncode}); log {log}:\n{tail}")
        print(f"character {f['name']}: created; asking the server to commit it")
        if not commit_characters(first):
            die("the characters table never got the row (is the server up?)")

    # 3. the veteran start, with the character online on a seat
    awarded = []
    if veteran and f["veteran_list"]:
        seat = f"citizen-{citizen}"
        r = subprocess.run([SEAT, "start", account, first, "--name", seat, "--timeout", "600"], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"seat for the veteran start failed: {r.stdout}{r.stderr}")
        try:
            for box in f["veteran_list"]:
                lines = lab(f"skill:{first}:{box}")
                ok = any("has=true" in l for l in lines)
                print(f"  {box}: {'awarded' if ok else 'FAILED ' + ' '.join(lines)}")
                if ok:
                    awarded.append(box)
        finally:
            subprocess.run([SEAT, "stop", seat], capture_output=True, text=True)

    # 3b. a new character wakes up in the tutorial: send it home (persona "home: <planet> <x> <y>")
    home = f.get("home", "").split()
    if len(home) == 3 and veteran:
        seat = f"citizen-{citizen}"
        r = subprocess.run([SEAT, "start", account, first, "--name", seat, "--timeout", "300"], capture_output=True, text=True)
        if r.returncode == 0:
            lines = lab(f"travel:{first}:{home[0]}:{home[1]}:{home[2]}")
            print(f"  home: {' '.join(lines) if lines else 'travel gave no answer'}")
            time.sleep(4)
            subprocess.run([SEAT, "stop", seat], capture_output=True, text=True)

    # 4. remember it
    state_dir = os.path.join(LABDIR, "citizens", citizen)
    os.makedirs(state_dir, exist_ok=True)
    state_path = os.path.join(state_dir, "state.json")
    try:
        state = json.load(open(state_path))
    except (OSError, ValueError):
        state = {}
    state.update({"account": account, "character": first, "name": f["name"], "created": time.strftime("%Y-%m-%d %H:%M:%S")})
    json.dump(state, open(state_path, "w"), indent=1)

    directory = load_directory()
    directory[citizen] = {
        "name": f["name"], "character": first, "account": account,
        "profession": f.get("profession", ""), "faction": f.get("faction", "neutral"),
        "home": f.get("home", ""), "sells": f.get("sells", ""), "veteran": awarded,
    }
    json.dump(directory, open(DIRECTORY, "w"), indent=1, sort_keys=True)
    print(f"directory: {citizen} recorded in {DIRECTORY}")


def load_directory():
    try:
        return json.load(open(DIRECTORY))
    except (OSError, ValueError):
        return {}


def cmd_status(args):
    citizen = args[0]
    f = character_section(citizen)
    print(f"account {f['account']}: {'exists' if account_exists(f['account']) else 'missing'}")
    print(f"character {f['name']}: {'exists' if character_exists(f['first']) else 'missing'}")
    for box in f["veteran_list"]:
        lines = lab(f"hasSkill:{f['first']}:{box}", 8)
        print(f"  {box}: {' '.join(lines) if lines else 'no answer (server down or character never loaded)'}")


# --- outfit: the kit a profession needs on day one, by template path (every path exists in the template table) ---
RIFLE = "object/weapon/ranged/rifle/rifle_cdef.iff"
PISTOL = "object/weapon/ranged/pistol/pistol_cdef.iff"
CARBINE = "object/weapon/ranged/carbine/carbine_cdef.iff"
SWORD_2H = "object/weapon/melee/2h_sword/2h_sword_cleaver.iff"
SURVEY_MINERAL = "object/tangible/survey_tool/survey_tool_mineral.iff"
ORE_DEED = "object/tangible/deed/harvester_deed/harvester_ore_s1_deed.iff"
MEDPACK = "object/tangible/medicine/crafted/medpack_damage_a.iff"
SLITHERHORN = "object/tangible/instrument/slitherhorn.iff"


def kit_for(fields):
    """[(template, count, equip)] from the persona's profession and veteran boxes, plus the energy units to give"""
    boxes = " ".join(fields.get("veteran_list", []))
    prof = fields.get("profession", "")
    kit, energy = [], 0
    weapon = None
    if "combat_rifleman" in boxes:
        weapon = RIFLE
    elif "combat_pistol" in boxes:
        weapon = PISTOL
    elif "combat_carbine" in boxes:
        weapon = CARBINE
    elif "combat_2hsword" in boxes:
        weapon = SWORD_2H
    elif prof.startswith("combat_marksman") or "combat_marksman_master" in boxes:
        weapon = RIFLE
    elif prof.startswith("outdoors_scout") or prof.startswith("science_medic"):
        weapon = CARBINE if prof.startswith("outdoors_scout") else PISTOL
    if weapon:
        kit.append((weapon, 1, True))
    if prof.startswith("crafting_artisan") or "crafting_artisan_survey" in boxes or "crafting_artisan_master" in boxes:
        deeds = 3 if "crafting_merchant" in boxes else 1   # the gatherer runs several harvesters
        kit += [(SURVEY_MINERAL, 1, False), (ORE_DEED, deeds, False)]
        energy = 2000 * deeds
    if prof.startswith("science_medic"):
        kit.append((MEDPACK, 5, False))
    if "social_musician" in boxes:
        kit.append((SLITHERHORN, 1, False))
    return kit, energy


def seat_is_up(name):
    sock = os.path.join(LABDIR, "seats", name, "sock")
    pidfile = os.path.join(LABDIR, "seats", name, "pid")
    try:
        os.kill(int(open(pidfile).read()), 0)
        return os.path.exists(sock)
    except (OSError, ValueError):
        return False


def cmd_outfit(args):
    citizen = args[0]
    keep = "--keep" in args
    f = character_section(citizen)
    first = f["first"]
    kit, energy = kit_for(f)
    if not kit and not energy:
        print(f"{citizen}: nothing in the kit for profession {f.get('profession')}")
        return 0
    started = False
    if not seat_is_up(citizen):
        print(f"seating {first} on {f['account']} for the hand-over …", flush=True)
        r = subprocess.run([SEAT, "start", f["account"], first, "--name", citizen, "--timeout", "600"], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"seat start failed: {(r.stdout + r.stderr).strip().splitlines()[-1:]}")
        started = True
    try:
        have = {}
        for line in lab(f"inventory:{first}", 10):
            m = re.search(r"oid=(\d+) path=(\S+)", line)
            if m:
                have.setdefault(m.group(2), []).append(m.group(1))
        for template, count, equip in kit:
            oids = list(have.get(template, []))
            missing = count - len(oids)
            for _ in range(max(0, missing)):
                lines = lab(f"give:{first}:{template}", 10)
                m = next((re.search(r"oid=(\d+)", l) for l in lines if "INFO item" in l), None)
                if not m:
                    print(f"  FAILED give {template}: {' '.join(lines)[:160]}")
                    continue
                oids.append(m.group(1))
                if template == ORE_DEED:
                    lab(f"deedValues:{m.group(1)}:120:12000", 10)   # what a crafted deed carries; a lab deed has 0/0
                print(f"  gave {os.path.basename(template)} (oid {m.group(1)})")
            if missing <= 0:
                print(f"  has {count} × {os.path.basename(template)}")
            if equip and oids:
                lines = lab(f"equip:{first}:{oids[0]}", 10)
                print(f"  equipped {os.path.basename(template)}: {' '.join(l for l in lines if 'equip' in l)[:120] or 'no answer'}")
        if energy:
            held = sum(1 for p in have if "resource_container" in p)
            if held:
                print(f"  has {held} resource container(s); energy not added")
            else:
                lines = lab(f"giveResource:{first}:wind:{energy}", 10)
                print(f"  gave {energy} wind energy: {' '.join(lines)[:120]}")
    finally:
        if started and not keep:
            subprocess.run([SEAT, "stop", citizen], capture_output=True, text=True)
            print("seat stopped (the hand-over is persisted by the server)")
    return 0


def cmd_list(args):
    directory = load_directory()
    for fn in sorted(os.listdir(CAST_DIR)):
        if not fn.endswith(".md"):
            continue
        citizen = fn[:-3]
        entry = directory.get(citizen)
        print(f"{citizen:<12} {'character ' + entry['character'] + ' on ' + entry['account'] if entry else 'no character yet'}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "new" and args:
        return cmd_new(args)
    if cmd == "status" and args:
        return cmd_status(args)
    if cmd == "outfit" and args:
        return cmd_outfit(args)
    if cmd == "list":
        return cmd_list(args)
    if cmd == "directory":
        print(json.dumps(load_directory(), indent=1, sort_keys=True))
        return 0
    die(f"unknown command '{cmd}' (new, status, list, directory)")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
