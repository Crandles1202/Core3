#!/usr/bin/env python3
"""dash — one screen for the whole bench: the three servers, who holds which bench, every agent's lane, a gate in
progress, the citizens on production. Read-only: nothing here takes a lock or sends a console command.

  tools/dash                 refresh every 5 s until Ctrl-C
  tools/dash --once          print once
  tools/dash --interval 10   another refresh period

Sources: tools/swg status (per instance), ~/.swg-lab/*.lock, ~/.swg-lab/gate.passed, ~/.swg-lab/last-*.log, git worktrees of
the main repo, docs/BOARD.md, ~/swg-live/DEPLOYED, tools/citizens/crew status (live).
"""
import os, re, subprocess, sys, time, glob, datetime

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
MAIN = os.path.expanduser("~/workspace/Core3")
LAB = os.path.expanduser("~/.swg-lab")
LIVE_ROOT = os.path.expanduser("~/swg-live")

def run(cmd, env=None, timeout=20):
    e = dict(os.environ); e.update(env or {})
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=e)
        return (r.stdout + r.stderr)
    except Exception as ex:  # noqa: BLE001
        return f"(error: {ex})"

def ago(ts):
    d = int(time.time() - ts)
    if d < 90: return f"{d}s"
    if d < 5400: return f"{d // 60}m"
    if d < 172800: return f"{d // 3600}h"
    return f"{d // 86400}d"

def hms(seconds):
    s = int(seconds); h, m = s // 3600, (s % 3600) // 60
    return f"{h}h{m:02d}m" if h else f"{m}m"

# ----------------------------------------------------------------------------------------------- servers
def server(name, env):
    out = run([os.path.join(MAIN, "tools/swg"), "status"], env)
    first = out.strip().splitlines()[0] if out.strip() else "?"
    m = re.search(r'core3 (\w+)(?:\s+pid (\d+))?(?:\s+up (\d+)s)?', first)
    state = m.group(1) if m else first[:20]
    pid = m.group(2) if m and m.group(2) else "-"
    up = hms(int(m.group(3))) if m and m.group(3) else "-"
    rev = ""
    mm = re.search(r'branch (\S+) @ (\S+)', out)
    if mm: rev = mm.group(2)
    md = re.search(r'deployed (\S+)', out)
    if md: rev = md.group(1)
    errs = ""
    me = re.search(r'(\d+) ERROR', out)
    if me: errs = me.group(1)
    return dict(name=name, state=state, pid=pid, up=up, rev=rev, errs=errs)

def lock(name):
    p = os.path.join(LAB, f"{name}.lock")
    try:
        parts = open(p).read().strip().split("|")
    except OSError:
        return "free"
    if len(parts) < 5 or not parts[0]: return "free"
    agent, purpose, _, since, expires = parts[:5]
    left = int(expires) - int(time.time())
    return f"{agent}: {purpose} ({'expires in ' + hms(left) if left > 0 else 'EXPIRED'})"

# ----------------------------------------------------------------------------------------------- gate
def gate():
    procs = run(["pgrep", "-af", "swg test all"])
    running = [l for l in procs.splitlines() if "pgrep" not in l]
    if not running:
        return None
    who = "?"
    for l in running:
        m = re.search(r'workspace/(Core3-[\w-]+)', l) or re.search(r'(swg-bench2)', l)
        if m: who = m.group(1).replace("Core3-", "")
    logs = sorted(glob.glob(os.path.join(LAB, "last-scenario-*.log")), key=os.path.getmtime)
    phase = "unit/lua/bot"
    if logs and time.time() - os.path.getmtime(logs[-1]) < 600:
        phase = "scenario " + os.path.basename(logs[-1]).replace("last-scenario-", "").replace(".first.log", "").replace(".log", "")
    unit = os.path.join(LAB, "last-unit.log")
    started = ago(os.path.getmtime(unit)) if os.path.exists(unit) else "?"
    return f"{who}: {phase} (unit tests {started} ago)"

# ----------------------------------------------------------------------------------------------- agents
def board_rows():
    rows = {}
    try:
        for l in open(os.path.join(MAIN, "docs/BOARD.md")):
            m = re.match(r'\| *(\w+) *\| *`?([^|`]*)`? *\| *([^|]*)\| *([^|]*)\|', l)
            if m: rows[m.group(2).strip()] = (m.group(1).strip(), m.group(3).strip(), m.group(4).strip())
    except OSError:
        pass
    return rows

def gated():
    try: return set(l.strip() for l in open(os.path.join(LAB, "gate.passed")))
    except OSError: return set()

def agents():
    out = run(["git", "-C", MAIN, "worktree", "list", "--porcelain"])
    rows, cur = [], {}
    for l in out.splitlines() + [""]:
        if not l:
            if cur: rows.append(cur); cur = {}
            continue
        k, _, v = l.partition(" ")
        cur[k] = v
    board = board_rows(); g = gated()
    result = []
    for w in rows:
        path = w.get("worktree", ""); branch = w.get("branch", "").replace("refs/heads/", "") or "(detached)"
        head = w.get("HEAD", "")[:10]
        last = run(["git", "-C", path, "log", "-1", "--format=%cr|%s"]).strip()
        when, _, subject = last.partition("|")
        name = "bench" if path == MAIN else os.path.basename(path).replace("Core3-", "")
        b = board.get(branch)
        status = b[2] if b else ("" if path == MAIN else "no board row")
        result.append(dict(name=name, branch=branch, head=head, when=when, subject=subject[:60], gated="gated" if w.get("HEAD", "") in g else "", status=status))
    return result

# ----------------------------------------------------------------------------------------------- citizens
def citizens():
    out = run([os.path.join(MAIN, "tools/citizens/crew"), "status"], {"SWG_INSTANCE": "live"})
    up = [l.split()[0] for l in out.splitlines() if "seat up" in l]
    down = [l.split()[0] for l in out.splitlines() if "seat down" in l]
    return up, down

# ----------------------------------------------------------------------------------------------- screen
def render():
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    lines = [f"FINAL BOSS   {now}", ""]
    lines.append("SERVERS")
    for s in (server("production", {"SWG_INSTANCE": "live"}), server("bench", {}), server("bench2", {"SWG_INSTANCE": "bench2"})):
        lines.append(f"  {s['name']:11} {s['state']:8} pid {s['pid']:<6} up {s['up']:<7} {s['rev']:36} {('errors ' + s['errs']) if s['errs'] and s['errs'] != '0' else ''}")
    try:
        dep = open(os.path.join(LIVE_ROOT, "DEPLOYED")).read().split("\n")
        lines.append(f"  production runs {dep[0]} since {dep[1] if len(dep) > 1 else '?'}")
    except OSError:
        pass
    tags = run(["git", "-C", MAIN, "tag", "-l", "chuck-stable-*"]).split()
    if tags: lines.append(f"  newest stable tag {sorted(tags)[-1]}   unstable @ {run(['git', '-C', MAIN, 'rev-parse', '--short', 'unstable']).strip()}")
    lines.append("")
    lines.append("BENCHES")
    lines.append(f"  bench   {lock('server')}")
    lines.append(f"  bench2  {lock('bench2')}")
    lines.append(f"  live    {lock('live')}")
    g = gate()
    lines.append(f"  gate    {g if g else 'none running'}")
    lines.append("")
    lines.append("AGENTS / LANES")
    for a in agents():
        lines.append(f"  {a['name']:11} {a['branch']:24} {a['head']}  {a['gated']:5} {a['when']:16} {a['subject']}")
        if a["status"]: lines.append(f"  {'':11} board: {a['status']}")
    lines.append("")
    up, down = citizens()
    lines.append("CITIZENS (production)")
    lines.append(f"  seated: {' '.join(up) if up else '-'}")
    lines.append(f"  down:   {' '.join(down) if down else '-'}")
    return "\n".join(lines)

def main(argv):
    once = "--once" in argv
    interval = 5
    if "--interval" in argv: interval = int(argv[argv.index("--interval") + 1])
    while True:
        text = render()
        if once: print(text); return 0
        sys.stdout.write("\033[2J\033[H" + text + f"\n\n(refresh {interval}s, Ctrl-C quits)\n"); sys.stdout.flush()
        try: time.sleep(interval)
        except KeyboardInterrupt: return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
