#!/usr/bin/env bash
#
# swg — Final Boss test-lab helper for the Core3 server.
#
#   swg start [--no-gdb] [clean]     start core3 in tmux session "swg", wait for READY
#   swg stop                         send "shutdown" at the console, wait for a clean exit
#   swg restart [--no-gdb]           stop + start
#   swg status                       is it running? pid, uptime, branch, last log line
#   swg cmd "<console command>"      send a console command, print the log lines it produced
#   swg logs [--errors] [--lua] [--tail N] [--follow]
#   swg test unit|lua|bot|scenario <name>|all   see "Tests" below
#   swg build                        ~/bin/build (client on), errors/warnings summarised
#   swg snap save|load|list <name>   mysqldump + copy of bin/databases (server stopped)
#   swg account create <user> <admin_level> [--reset]
#                                    create a test account the way the server hashes passwords;
#                                    the generated password is written to ~/.swg-lab/<user>.pass
#   swg account prune <user> [--keep N]
#                                    delete the oldest Lab* characters of a lab account (claude-*
#                                    only) the way the login server does, keeping the N newest (4);
#                                    test bot runs it when the account is at the 10-character cap
#   swg tre build|install|status [--client DIR]
#   swg site save <char> <name> | site list   # write an in-game site draft into tasks/sites/
#
# Working in parallel (several agents, one server = "the bench", see docs/BOARD.md)
#   swg whoami                       which agent this checkout is (.swg-agent in the worktree, or SWG_AGENT)
#   swg lock [purpose] [--minutes N] hold the bench for this agent (default 60 min); swg unlock [--force]
#   swg agent new <name>             a worktree ../Core3-<name> on feature/<name> for a new agent; agent list;
#                                    agent done <name> (after its branch is merged)
#   swg bench use <branch>           deploy that branch on the bench (build / restart / reload as needed)
#   swg bench status | release       what is deployed, built, running; release = back to unstable + unlock
#   swg bench merge <branch>         gate passed on that commit → merge --no-ff into unstable + push
#   Every command that touches the server takes the lock for its duration; a second agent is refused with the
#   owner's name and purpose (--wait blocks until free). "swg cmd --shared …" is for read-only oracles.
#   swg test planner                        # headless check of the site planner's data (in test all)
#                                    tools/tre: pack tre-src/ into finalboss.tre and install it for the
#                                    server (TrePath) and the client (DIR, remembered in ~/.swg-lab/).
#                                    start/test unit do build+install themselves; start adds the
#                                    server's "reloadstrings" argument when the archive changed.
#
# Tests
#   unit   core3 runUnitTests (gtest). Server must be stopped. Builds + installs finalboss.tre first.
#   lua    runLuaFunction FbLabTests:runAll[:<char>] on the live server; prints PASS/FAIL lines.
#          With <char> online, also checks that character's inventory for the starter gear.
#   bot    core3client logs in as claude-player, creates a character, zones in, waits 30 s,
#          runs the lua tests against that character, logs out.
#          Pass = exit code 0 and no new ERROR lines in the server log.
#   scenario <name>|all   tools/scenarios/<name>.sh: bot + Lua oracle driving real gameplay
#          (see tools/scenarios/lib.sh). Server must be running.
#   all    stop if running, unit, start, lua, bot, scenarios (server is left running).
#
# Nothing here writes passwords into the repo: credentials live in ~/.swg-lab/ (mode 600).

set -uo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# the server (binary, console log, ODB, client) lives in the main checkout = the bench, even when this copy of
# the script runs from an agent's worktree
BENCH=$(git -C "$REPO" worktree list --porcelain 2>/dev/null | head -n1 | sed 's/^worktree //')
[ -n "$BENCH" ] || BENCH=$REPO
BIN="$BENCH/MMOCoreORB/bin"
LOG="$BIN/screenlog.0"
SESSION=${SWG_TMUX_SESSION:-swg}
SNAPDIR=${SWG_SNAPDIR:-$HOME/swg-snapshots}
LABDIR=${SWG_LABDIR:-$HOME/.swg-lab}
LOCKFILE="$LABDIR/server.lock"
DBNAME=swgemu

# ---------------------------------------------------------------- the live instance (swg --live …, SWG_INSTANCE=live)
# A second core3 beside the bench: its own runtime (~/swg-live/bin: the binaries and scripts deployed from the bench's
# unstable by `swg live deploy`, its own conf/config-local.lua, ODB and logs), its own MySQL database (swgemu_live),
# its own ports (the bench's + 1000: login 45453, zone 45463, ping 45462, status 45455, ORB 45419, web 45460), its own
# archive folder (~/swg-live/tre: links to the stock archives, its own finalboss.tre), tmux session swg-live and lock.
# The bench keeps every gate, deploy and build; the live instance is for play and the citizens and restarts only on
# purpose. start/stop/status/cmd/logs/snap/account work on it; bench/test/build/agent/site/tre are refused.
INSTANCE=${SWG_INSTANCE:-bench}
if [ "${1:-}" = "--live" ]; then INSTANCE=live; shift; fi
LIVE_ROOT=${SWG_LIVE_ROOT:-$HOME/swg-live}
LIVE_PORT_BASE=${SWG_LIVE_PORT_BASE:-45000}
if [ "$INSTANCE" = live ]; then
	BIN="$LIVE_ROOT/bin"
	LOG="$BIN/screenlog.0"
	SESSION=${SWG_TMUX_SESSION:-live}   # not "swg-…": tmux matches a session name by prefix when no exact name exists
	LOCKFILE="$LABDIR/live.lock"
	SNAPDIR=${SWG_SNAPDIR:-$HOME/swg-snapshots/live}
	DBNAME=swgemu_live
	export SWG_INSTANCE=live
	export SWG_LOGIN_PORT=${SWG_LOGIN_PORT:-$((LIVE_PORT_BASE + 453))}
fi

# ---------------------------------------------------------------- agents and the bench lock

agent_name() {
	if [ -n "${SWG_AGENT:-}" ]; then printf '%s\n' "$SWG_AGENT"
	elif [ -f "$REPO/.swg-agent" ]; then head -n1 "$REPO/.swg-agent"
	elif [ "$REPO" = "$BENCH" ]; then printf 'bench\n'
	else basename "$REPO"; fi
}

# lock file: agent|purpose|pid|since|until   (pid>0: an automatic lock that dies with its process;
# pid=0: a hold with an expiry)
lock_read() { [ -f "$LOCKFILE" ] && cat "$LOCKFILE" || true; }
lock_field() { lock_read | cut -d'|' -f"$1"; }
lock_is_stale() {
	local rec; rec=$(lock_read); [ -n "$rec" ] || return 0
	local pid until; pid=$(cut -d'|' -f3 <<<"$rec"); until=$(cut -d'|' -f5 <<<"$rec")
	if [ "${pid:-0}" -gt 0 ] 2>/dev/null; then kill -0 "$pid" 2>/dev/null && return 1 || return 0; fi
	[ "$(date +%s)" -ge "${until:-0}" ]
}
lock_describe() {
	local rec; rec=$(lock_read); [ -n "$rec" ] || { echo "free"; return; }
	local agent purpose pid since until; IFS='|' read -r agent purpose pid since until <<<"$rec"
	local age=$(( $(date +%s) - since ))
	if lock_is_stale; then echo "stale lock by $agent ($purpose) from $((age/60)) min ago"
	elif [ "${pid:-0}" -gt 0 ] 2>/dev/null; then echo "held by $agent: $purpose (pid $pid, $((age/60)) min)"
	else echo "held by $agent: $purpose (expires in $(( (until - $(date +%s)) / 60 )) min)"; fi
}
# take the lock for this process (or run under a hold we already own); refuses when another agent has it
lock_acquire() {
	local purpose=$1 me; me=$(agent_name)
	mkdir -p "$LABDIR"; chmod 700 "$LABDIR"
	local tries=0
	while :; do
		if lock_is_stale; then
			[ -f "$LOCKFILE" ] && warn "bench: clearing a $(lock_describe)"
			printf '%s|%s|%s|%s|%s\n' "$me" "$purpose" "$$" "$(date +%s)" 0 >"$LOCKFILE"; LOCK_MINE=auto; return 0
		fi
		if [ "$(lock_field 1)" = "$me" ]; then LOCK_MINE=held; return 0; fi
		if [ "${SWG_WAIT:-0}" = 1 ] && (( tries < 720 )); then
			(( tries % 12 == 0 )) && warn "bench $(lock_describe) — waiting"
			sleep 5; tries=$((tries + 1)); continue
		fi
		die "bench $(lock_describe). Try again later, SWG_WAIT=1 to wait, or 'swg unlock --force' if it is abandoned. (you are: $me)"
	done
}
lock_release() { [ "${LOCK_MINE:-}" = auto ] && rm -f "$LOCKFILE"; LOCK_MINE=; }
# run a command under the lock (nested swg calls from the same agent pass through)
with_lock() {
	local purpose=$1; shift
	lock_acquire "$purpose"
	trap 'lock_release' EXIT
	"$@"; local rc=$?
	lock_release; trap - EXIT
	return $rc
}

cmd_whoami() { [ "$INSTANCE" = live ] && say "instance: live ($LIVE_ROOT, login $((LIVE_PORT_BASE + 453)))"; say "$(agent_name)  (checkout $REPO$( [ "$REPO" = "$BENCH" ] && echo ", the bench" || echo "; bench $BENCH"))"; }

cmd_lock() {
	local purpose="" minutes=60
	while [ $# -gt 0 ]; do case "$1" in --minutes) minutes=$2; shift 2 ;; *) purpose="${purpose:+$purpose }$1"; shift ;; esac; done
	[ -n "$purpose" ] || purpose="working"
	local me; me=$(agent_name)
	if ! lock_is_stale && [ "$(lock_field 1)" != "$me" ]; then die "bench $(lock_describe)"; fi
	mkdir -p "$LABDIR"; printf '%s|%s|0|%s|%s\n' "$me" "$purpose" "$(date +%s)" "$(( $(date +%s) + minutes * 60 ))" >"$LOCKFILE"
	say "bench held by $me for $minutes min: $purpose"
}
cmd_unlock() {
	[ -f "$LOCKFILE" ] || { say "bench is free"; return 0; }
	if [ "${1:-}" != "--force" ] && [ "$(lock_field 1)" != "$(agent_name)" ] && ! lock_is_stale; then die "bench $(lock_describe); --force to take it anyway"; fi
	rm -f "$LOCKFILE"; say "bench released"
}

cmd_agent() {
	local what=${1:-}; shift || true
	case "$what" in
		new)
			local name=${1:-}; [ -n "$name" ] || die "usage: swg agent new <name>"
			[[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "name: lower-case letters, digits, . _ -"
			local dir="$BENCH/../Core3-$name" branch="feature/$name"
			[ -e "$dir" ] && die "$dir exists"
			git -C "$BENCH" fetch -q origin unstable 2>/dev/null || true
			git -C "$BENCH" worktree add -q "$dir" -b "$branch" unstable || die "worktree add failed"
			printf '%s\n' "$name" >"$dir/.swg-agent"
			dir=$(cd "$dir" && pwd)
			say "agent '$name': worktree $dir on $branch (from unstable)"
			say "start it with:   cd $dir && claude"
			say "it reads CLAUDE.md there; docs/BOARD.md has the parallel-work rules. Add a row to the board for it."
			;;
		list)
			git -C "$BENCH" worktree list
			say "bench lock: $(lock_describe)" ;;
		done)
			local name=${1:-}; [ -n "$name" ] || die "usage: swg agent done <name>"
			local dir="$BENCH/../Core3-$name" branch="feature/$name"
			if git -C "$BENCH" show-ref -q "refs/heads/$branch" && ! git -C "$BENCH" branch --merged unstable | grep -q " $branch\$"; then
				die "$branch is not merged into unstable yet (swg bench merge $branch)"
			fi
			# the agent may still hold the bench: give it back first (release needs a clean bench checkout)
			if [ -f "$LOCKFILE" ] && [ "$(lock_field 1)" = "$name" ]; then rm -f "$LOCKFILE"; git -C "$BENCH" checkout -q unstable 2>/dev/null || true; say "bench released (was held by $name)"; fi
			[ -d "$dir" ] && { git -C "$BENCH" worktree remove "$dir" || die "worktree remove failed (uncommitted work? --force by hand)"; }
			git -C "$BENCH" branch -d "$branch" 2>/dev/null || true
			say "agent '$name' retired: worktree and branch removed" ;;
		*) die "usage: swg agent new <name> | list | done <name>" ;;
	esac
}

bench_running_file() { echo "$LABDIR/bench.running"; }
bench_built_file() { echo "$LABDIR/bench.built"; }
bench_note_running() { git -C "$BENCH" rev-parse HEAD >"$(bench_running_file)" 2>/dev/null || true; }
bench_note_built() { git -C "$BENCH" rev-parse HEAD >"$(bench_built_file)" 2>/dev/null || true; }

cmd_bench() {
	local what=${1:-}; shift || true
	case "$what" in
		status)
			local head branch; head=$(git -C "$BENCH" rev-parse --short HEAD); branch=$(git -C "$BENCH" rev-parse --abbrev-ref HEAD)
			say "bench      $BENCH @ $head ($branch)$( [ -n "$(git -C "$BENCH" status --porcelain)" ] && echo "  DIRTY")"
			say "built      $(cat "$(bench_built_file)" 2>/dev/null | cut -c1-10 || echo unknown)   running $(cat "$(bench_running_file)" 2>/dev/null | cut -c1-10 || echo unknown)   server $(is_running && echo RUNNING || echo STOPPED)"
			say "lock       $(lock_describe)"
			git -C "$BENCH" worktree list | sed 's/^/worktree   /' ;;
		use)
			local target=${1:-}; [ -n "$target" ] || die "usage: swg bench use <branch|commit>"
			local commit; commit=$(git -C "$BENCH" rev-parse --verify -q "$target^{commit}") || die "unknown branch/commit $target"
			[ -z "$(git -C "$BENCH" status --porcelain)" ] || die "the bench checkout is dirty ($BENCH): nobody edits files there; commit or stash by hand"
			local tries=0
			while ! lock_is_stale && [ "$(lock_field 1)" != "$(agent_name)" ]; do   # SWG_WAIT=1 queues behind another agent's hold
				[ "${SWG_WAIT:-0}" = 1 ] && (( tries < 720 )) || die "bench $(lock_describe)"
				(( tries % 12 == 0 )) && warn "bench $(lock_describe) — waiting"
				sleep 5; tries=$((tries + 1))
			done
			cmd_lock "bench use $target" --minutes 90 >/dev/null
			local was; was=$(git -C "$BENCH" rev-parse HEAD)
			git -C "$BENCH" checkout -q --detach "$commit" || die "checkout failed"
			say "bench now at $(git -C "$BENCH" rev-parse --short HEAD) ($target)"
			local built running; built=$(cat "$(bench_built_file)" 2>/dev/null || echo ""); running=$(cat "$(bench_running_file)" 2>/dev/null || echo "")
			local need=reload
			if [ -z "$built" ] || ! git -C "$BENCH" diff --quiet "$built" "$commit" -- MMOCoreORB/src; then need=build
			elif [ -z "$running" ] || ! git -C "$BENCH" diff --quiet "$running" "$commit" -- MMOCoreORB/bin/scripts/mobile MMOCoreORB/bin/scripts/managers MMOCoreORB/bin/scripts/object MMOCoreORB/bin/conf tre-src; then need=restart
			fi
			if ! is_running; then [ "$need" = build ] || need=start; fi
			case "$need" in
				build) say "C++ changed since the last build: building"; cmd_build || die "build failed"; bench_note_built
				       if is_running; then cmd_stop || die "stop failed"; fi; cmd_start || die "start failed"; bench_note_running ;;
				restart) say "mobile/manager/object/conf/tre files changed: restarting"; cmd_stop || die "stop failed"; cmd_start || die "start failed"; bench_note_running ;;
				start) cmd_start || die "start failed"; bench_note_running ;;
				reload) say "Lua-only change: reloadscreenplays"; cmd_cmd reloadscreenplays >/dev/null; bench_note_running ;;
			esac
			say "deployed. Test with swg test …; 'swg bench release' when done." ;;
		release)
			[ -z "$(git -C "$BENCH" status --porcelain)" ] || die "the bench checkout is dirty; clean it by hand first"
			git -C "$BENCH" checkout -q unstable || die "checkout unstable failed"
			cmd_unlock
			local running; running=$(cat "$(bench_running_file)" 2>/dev/null || echo "")
			if [ -n "$running" ] && [ "$running" != "$(git -C "$BENCH" rev-parse HEAD)" ]; then warn "note: the server still runs $(cut -c1-10 <<<"$running"); the next 'bench use' puts it right"; fi ;;
		merge)
			local branch=${1:-}; [ -n "$branch" ] || die "usage: swg bench merge <branch>"
			local commit; commit=$(git -C "$BENCH" rev-parse --verify -q "$branch^{commit}") || die "unknown branch $branch"
			grep -qx "$commit" "$LABDIR/gate.passed" 2>/dev/null || die "no green 'swg test all' recorded for $branch @ $(cut -c1-10 <<<"$commit"): swg bench use $branch && swg test all"
			if lock_is_stale || [ "$(lock_field 1)" = "$(agent_name)" ]; then :; else die "bench $(lock_describe)"; fi
			[ -z "$(git -C "$BENCH" status --porcelain)" ] || die "the bench checkout is dirty"
			git -C "$BENCH" checkout -q unstable || die "checkout unstable failed"
			git -C "$BENCH" merge --no-ff "$branch" -m "Merge $branch (gate passed on $(cut -c1-10 <<<"$commit"))" || die "merge failed: resolve by hand in $BENCH"
			git -C "$BENCH" push origin unstable || die "push failed"
			say "merged $branch into unstable and pushed. 'swg agent done <name>' retires its worktree." ;;
		*) die "usage: swg bench status | use <branch> | release | merge <branch>" ;;
	esac
}
GDB_SETTINGS=${SWG_GDB_SETTINGS:-$HOME/bin/gdb_settings}
START_TIMEOUT=${SWG_START_TIMEOUT:-420}
STOP_TIMEOUT=${SWG_STOP_TIMEOUT:-240}
CMD_TIMEOUT=${SWG_CMD_TIMEOUT:-20}

# ERROR lines that appear on every boot and are not ours (see CLAUDE.md "Known baseline log noise").
NOISE_RE='MantisDatabase0\] ERROR - 1045|\[Console\] ERROR - 1045|TemplateManager\] ERROR - unknown appearance type SPRT'

# ---------------------------------------------------------------- helpers

say()  { printf '%s\n' "$*"; }
warn() { printf 'swg: %s\n' "$*" >&2; }
die()  { warn "$@"; exit 1; }

strip_tty() { sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r$//' -e 's/\r/\n/g'; }

core3_pid() {
	local p want; want=$(readlink -f "$BIN" 2>/dev/null)
	for p in $(pgrep -x core3); do
		[ "$(readlink -f "/proc/$p/cwd" 2>/dev/null)" = "$want" ] && { echo "$p"; return; }
	done
}
is_running()  { [ -n "$(core3_pid)" ]; }
# every tmux target is "=$SESSION": without the "=" tmux falls back to prefix matching, and with two servers "swg" would
# reach "swg-live" when the bench session is down (the first live instance died that way, 2026-10-25)
has_session() { tmux has-session -t "=$SESSION" 2>/dev/null; }

session_running_gdb() {
	# pane command is "gdb" while gdb owns the pane
	[ "$(tmux display-message -p -t "=$SESSION" '#{pane_current_command}' 2>/dev/null)" = "gdb" ]
}

# core3 alive but stopped under the debugger (a gdb catchpoint fired: SIGSEGV/SIGUSR1); the process
# state is 't' (traced/stopped). The console is dead until gdb continues or kills it.
halted_in_gdb() {
	local pid; pid=$(core3_pid); [ -n "$pid" ] || return 1
	case "$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ')" in t*|T*) return 0 ;; esac
	return 1
}

log_lines() { [ -f "$LOG" ] && wc -l < "$LOG" || echo 0; }

count_errors() {
	# ERROR/FATAL lines in the current run, minus known noise
	[ -f "$LOG" ] || { echo 0; return; }
	grep -acE '(^|[^A-Za-z])(ERROR|FATAL)( |$|:|\])' "$LOG" | tr -d ' ' >/dev/null
	grep -aE '(ERROR|FATAL)' "$LOG" | grep -avE "$NOISE_RE" | wc -l | tr -d ' '
}

require_running() { is_running || die "server is not running (swg start)"; }
require_stopped() {
	if is_running; then die "server is running — stop it first (swg stop)"; fi
	if has_session; then die "tmux session '$SESSION' still exists; attach with: tmux attach -t $SESSION"; fi
}

TRE="$REPO/tools/tre"
TRE_SHA_FILE="$LABDIR/last-tre.sha"
[ "$INSTANCE" = live ] && TRE_SHA_FILE="$LABDIR/live-last-tre.sha"
LIVE_RELOAD_MARK="$LABDIR/live.reloadstrings"
# Build tre-src/ into finalboss.tre and install it into the server's TrePath. Prints the tool's lines.
# Returns 0 when the installed archive differs from the one the last `swg start` ran with.
tre_prepare() {
	[ -x "$TRE" ] || die "$TRE missing"
	local out
	out=$("$TRE" build 2>&1) || { printf '%s\n' "$out" >&2; die "tre build failed"; }
	say "$(printf '%s\n' "$out" | head -1)"
	out=$("$TRE" install 2>&1) || { printf '%s\n' "$out" >&2; die "tre install failed"; }
	printf '%s\n' "$out" | grep -v '^up to date' | sed 's/^/  /'
	local sha; sha=$("$TRE" status --json | tail -1 | sed -n 's/.*"server": "\([0-9a-f]*\)".*/\1/p')
	[ -n "$sha" ] || return 1
	[ "$(cat "$TRE_SHA_FILE" 2>/dev/null)" != "$sha" ]
}
tre_mark_seen() { mkdir -p "$LABDIR"; "$TRE" status --json | tail -1 | sed -n 's/.*"server": "\([0-9a-f]*\)".*/\1/p' > "$TRE_SHA_FILE"; }

git_rev() { git -C "$REPO" describe --always --dirty --abbrev=10 2>/dev/null; }
git_branch() { git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null; }

dbsecret() {
	# Core3.DBSecret from config-local.lua wins, then the default in config.lua,
	# then ConfigManager's compiled-in fallback.
	local s
	s=$(sed -n 's/^[[:space:]]*Core3\.DBSecret[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$BIN/conf/config-local.lua" 2>/dev/null | tail -n1)
	[ -n "$s" ] || s=$(sed -n 's/^[[:space:]]*DBSecret[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$BIN/conf/config.lua" 2>/dev/null | tail -n1)
	[ -n "$s" ] || s="swgemusecret"
	printf '%s' "$s"
}

rotate_logs() {
	# same scheme as ~/bin/run: keep 5 gzipped previous console logs
	[ -f "$LOG" ] || return 0
	local i j
	for i in 5 4 3 2 1; do
		j=$((i - 1))
		mv "$BIN/o_screenlog.$j.gz" "$BIN/o_screenlog.$i.gz" 2>/dev/null
	done
	mv "$LOG" "$BIN/o_screenlog.0" && gzip -f "$BIN/o_screenlog.0"
}

# ---------------------------------------------------------------- start / stop

# Chuck's Phase 0.3 cron job (~/bin/swg-backup-daily.sh, 03:00) only fires while WSL is up, which it
# usually is not at 03:00. Run it on server start instead when the newest dump is older than a day.
nightly_backup_if_due() {
	local script="$HOME/bin/swg-backup-daily.sh" dir="$HOME/backups/daily"
	[ -x "$script" ] || return 0
	local newest; newest=$(ls -1t "$dir"/swgemu-*.sql.gz 2>/dev/null | head -n1)
	if [ -z "$newest" ] || [ -n "$(find "$newest" -mmin +1440 2>/dev/null)" ]; then
		say "MySQL backup is older than a day — running $script"
		"$script" && say "backup: $(ls -1t "$dir"/swgemu-*.sql.gz | head -n1)"
	fi
}

cmd_start() {
	local use_gdb=1 clean=""
	for a in "$@"; do
		case "$a" in
			--no-gdb) use_gdb=0 ;;
			--gdb)    use_gdb=1 ;;
			clean)    clean="clean" ;;
			*) die "start: unknown argument '$a'" ;;
		esac
	done
	is_running && die "core3 is already running (pid $(core3_pid))"
	has_session && die "tmux session '$SESSION' already exists; attach with: tmux attach -t $SESSION"
	[ -x "$BIN/core3" ] || die "$BIN/core3 not found — run ~/bin/build"
	[ -z "$clean" ] || die "refusing 'clean' (wipes bin/databases and MySQL characters) — do that by hand if you mean it"

	rotate_logs
	: > "$LOG"
	nightly_backup_if_due

	local core3_args=""
	if [ "$INSTANCE" = live ]; then
		if [ -f "$LIVE_RELOAD_MARK" ]; then
			core3_args="reloadstrings"
			say "finalboss.tre was deployed since the last start: core3 will re-read every string table (reloadstrings)"
		fi
	elif tre_prepare; then
		core3_args="reloadstrings"
		say "finalboss.tre changed since the last start: core3 will re-read every string table (reloadstrings)"
	fi

	local launch
	if [ "$use_gdb" = 1 ]; then
		[ -f "$GDB_SETTINGS" ] || die "gdb settings file $GDB_SETTINGS missing (use --no-gdb)"
		launch="exec gdb --quiet --command=$GDB_SETTINGS --args ./core3 $core3_args"
	else
		launch="exec ./core3 $core3_args"
	fi

	tmux new-session -d -s "$SESSION" -c "$BIN" -x 250 -y 50 || die "could not create tmux session"
	tmux pipe-pane -o -t "=$SESSION" "cat >> '$LOG'"
	tmux send-keys -t "=$SESSION" -l -- "$launch"
	tmux send-keys -t "=$SESSION" Enter

	if [ "$INSTANCE" = live ]; then
		say "starting the live core3 ($( [ "$use_gdb" = 1 ] && echo under gdb || echo no gdb ), deployed $(cat "$LIVE_ROOT/DEPLOYED" 2>/dev/null || echo '?'), ports $((LIVE_PORT_BASE + 453))/$((LIVE_PORT_BASE + 463))) in tmux session '$SESSION'"
	else
		say "starting core3 ($( [ "$use_gdb" = 1 ] && echo under gdb || echo no gdb ), branch $(git_branch) @ $(git_rev)) in tmux session '$SESSION'"
	fi
	local t0=$SECONDS
	while (( SECONDS - t0 < START_TIMEOUT )); do
		if grep -aq '^READY' "$LOG" 2>/dev/null; then
			if [ "$INSTANCE" = live ]; then rm -f "$LIVE_RELOAD_MARK"; else tre_mark_seen; fi
			say "READY after $((SECONDS - t0))s  (pid $(core3_pid), errors so far: $(count_errors))"
			return 0
		fi
		if ! has_session; then
			warn "tmux session ended before READY; last log lines:"
			tail -n 25 "$LOG" | strip_tty >&2
			return 1
		fi
		if grep -aqE '^\[Inferior 1 \(process [0-9]+\) exited|^exit\(|Program received signal|Program terminated' "$LOG" 2>/dev/null; then
			warn "core3 exited before READY; last log lines:"
			tail -n 25 "$LOG" | strip_tty >&2
			return 1
		fi
		sleep 1
	done
	warn "timed out after ${START_TIMEOUT}s waiting for READY"
	return 1
}

cmd_stop() {
	if ! is_running; then
		if has_session; then
			if session_running_gdb; then
				say "core3 not running but gdb is idle in the session — quitting gdb"
				tmux send-keys -t "=$SESSION" -l -- "quit"; tmux send-keys -t "=$SESSION" Enter
				sleep 2
			fi
			has_session && tmux kill-session -t "=$SESSION"
			say "cleaned up tmux session '$SESSION'"
		else
			say "server is not running"
		fi
		return 0
	fi
	has_session || die "core3 (pid $(core3_pid)) is running but not in tmux session '$SESSION' — it was not started by swg; stop it at its own console"

	if halted_in_gdb; then
		# no console to type 'shutdown' into: the process sits on a fatal signal. Kill it from gdb
		# (the periodic ODB backup is the last saved state) and keep the backtrace.
		warn "core3 is halted in gdb (crashed) — killing it from gdb; backtrace kept in $BIN/gdb.log"
		tmux send-keys -t "=$SESSION" -l -- "kill"; tmux send-keys -t "=$SESSION" Enter; sleep 1
		tmux send-keys -t "=$SESSION" -l -- "y"; tmux send-keys -t "=$SESSION" Enter; sleep 2
		tmux send-keys -t "=$SESSION" -l -- "quit"; tmux send-keys -t "=$SESSION" Enter; sleep 2
		has_session && tmux kill-session -t "=$SESSION"
		is_running && die "core3 still alive after gdb kill — attach with: tmux attach -t $SESSION"
		mkdir -p "$LABDIR/crashes"; [ -f "$BIN/gdb.log" ] && cp "$BIN/gdb.log" "$LABDIR/crashes/gdb-$(date +%Y%m%d-%H%M%S).log"
		return 1
	fi
	say "sending 'shutdown' to pid $(core3_pid)"
	tmux send-keys -t "=$SESSION" -l -- "shutdown"
	tmux send-keys -t "=$SESSION" Enter

	local t0=$SECONDS
	while is_running; do
		if (( SECONDS - t0 >= STOP_TIMEOUT )); then
			warn "core3 still running after ${STOP_TIMEOUT}s — NOT killing it. Attach with: tmux attach -t $SESSION"
			return 1
		fi
		sleep 1
	done
	say "core3 exited after $((SECONDS - t0))s"

	# under gdb the (gdb) prompt is left behind; quit it (hook-quit disables confirm)
	local w=0
	while has_session && (( w < 15 )); do
		if session_running_gdb; then
			tmux send-keys -t "=$SESSION" -l -- "quit"; tmux send-keys -t "=$SESSION" Enter
		fi
		sleep 1; w=$((w + 1))
	done
	if has_session; then
		warn "tmux session still alive; killing it (core3 itself has already exited)"
		tmux kill-session -t "=$SESSION"
	fi
	if grep -aqE 'Program received signal|SIG(SEGV|ABRT) Caught' "$LOG" 2>/dev/null; then
		mkdir -p "$LABDIR/crashes"; [ -f "$BIN/gdb.log" ] && cp "$BIN/gdb.log" "$LABDIR/crashes/gdb-$(date +%Y%m%d-%H%M%S).log"
		warn "crash markers in the log — see $BIN/gdb.log (copied to $LABDIR/crashes/)"
		return 2
	fi
	return 0
}

cmd_status() {
	if halted_in_gdb; then
		local pid; pid=$(core3_pid)
		say "core3 HALTED IN GDB  pid $pid  up $(ps -o etimes= -p "$pid" | tr -d ' ')s  (a catchpoint fired — backtrace in $BIN/gdb.log; 'tmux attach -t $SESSION' to inspect, 'swg stop' kills it)"
	elif is_running; then
		local pid; pid=$(core3_pid)
		say "core3 RUNNING  pid $pid  up $(ps -o etimes= -p "$pid" | tr -d ' ')s  $(has_session && echo "tmux:$SESSION" || echo "tmux:none")"
	else
		say "core3 STOPPED  $(has_session && echo "(tmux session '$SESSION' still exists)" || true)"
	fi
	if [ "$INSTANCE" = live ]; then
		say "instance LIVE  $LIVE_ROOT  deployed $(head -n1 "$LIVE_ROOT/DEPLOYED" 2>/dev/null || echo '?') ($(sed -n 2p "$LIVE_ROOT/DEPLOYED" 2>/dev/null))  login $((LIVE_PORT_BASE + 453))  db $DBNAME"
	else
		say "branch $(git_branch) @ $(git_rev)$( [ "$REPO" != "$BENCH" ] && echo "   (this checkout: $(agent_name); the server runs from the bench $BENCH)")"
	fi
	say "bench   $(lock_describe)"
	[ -x "$BIN/core3" ] && say "binary  $(date -r "$BIN/core3" '+%F %T')  $( [ -x "$BIN/core3client" ] && echo "core3client: yes" || echo "core3client: missing")"
	if [ -f "$LOG" ]; then
		say "log     $LOG  ($(log_lines) lines, $(count_errors) ERROR/FATAL excl. noise)"
		say "last:   $(tail -n 1 "$LOG" | strip_tty | cut -c1-160)"
	fi
}

# ---------------------------------------------------------------- console

cmd_cmd() {
	[ "${1:-}" = "--shared" ] && shift
	[ $# -ge 1 ] || die "usage: swg cmd \"<console command>\" [--timeout N]"
	local command="$1"; shift
	local timeout=$CMD_TIMEOUT
	while [ $# -gt 0 ]; do
		case "$1" in --timeout) timeout=$2; shift 2 ;; *) die "cmd: unknown option $1" ;; esac
	done
	require_running
	has_session || die "core3 is not running in tmux session '$SESSION'"

	local before; before=$(log_lines)
	tmux send-keys -t "=$SESSION" -l -- "$command"
	tmux send-keys -t "=$SESSION" Enter

	# wait until the log stops growing (2 quiet polls of 0.25 s) or the timeout hits
	local t0=$SECONDS last=$before now quiet=0
	while (( SECONDS - t0 < timeout )); do
		sleep 0.25
		now=$(log_lines)
		if (( now != last )); then last=$now; quiet=0
		else
			quiet=$((quiet + 1))
			(( quiet >= 2 && now > before )) && break
		fi
	done
	tail -n "+$((before + 1))" "$LOG" | strip_tty | grep -av '^[[:space:]]*>*[[:space:]]*$'
}

cmd_logs() {
	local errors=0 n=50 follow=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--lua) LOG="$BIN/log/lua.log"; shift ;;
			--errors) errors=1; shift ;;
			--tail)   n=$2; shift 2 ;;
			--follow|-f) follow=1; shift ;;
			*) die "logs: unknown option $1" ;;
		esac
	done
	[ -f "$LOG" ] || die "no $LOG"
	if [ "$errors" = 1 ]; then
		grep -anE '(ERROR|FATAL)' "$LOG" | grep -avE "$NOISE_RE" | strip_tty
		say "-- $(count_errors) ERROR/FATAL line(s) excluding known noise"
	elif [ "$follow" = 1 ]; then
		tail -n "$n" -f "$LOG" | strip_tty
	else
		tail -n "$n" "$LOG" | strip_tty
	fi
}

# ---------------------------------------------------------------- tests

test_unit() {
	require_stopped
	[ -x "$BIN/core3" ] || die "$BIN/core3 not found"
	tre_prepare || true
	say "== unit: core3 runUnitTests $*"
	( cd "$BIN" && ./core3 runUnitTests "$@" 2>&1 | strip_tty | tee "$LABDIR/last-unit.log" | grep -aE '^\[==========\]|^\[  (PASSED|FAILED)  \]|^\[  SKIPPED \]|FAILED TEST|Failure|^\[ RUN      \].*' | grep -av '^\[ RUN' )
	local rc=${PIPESTATUS[0]}
	# the real exit code is core3's, which the subshell pipeline above lost; read it from the summary
	if grep -aq '^\[  PASSED  \]' "$LABDIR/last-unit.log" && ! grep -aq '^\[  FAILED  \]' "$LABDIR/last-unit.log"; then
		say "== unit: PASS  (full output: $LABDIR/last-unit.log)"; return 0
	fi
	say "== unit: FAIL  (full output: $LABDIR/last-unit.log)"; return 1
}

test_lua() {
	local char="${1:-}"
	require_running
	local fn="FbLabTests:runAll"
	[ -n "$char" ] && fn="$fn:$char"
	say "== lua: runLuaFunction $fn"
	# pick up edits to fb_lab_tests.lua without a restart (its spawnMobile wrapper is reload-safe;
	# screenplay start() is not re-run, so nothing re-spawns)
	cmd_cmd "reloadscreenplays" --timeout 15 >/dev/null 2>&1
	local out
	out=$(cmd_cmd "runLuaFunction $fn" --timeout 30)
	if [ "${LAB_QUIET:-0}" = 1 ]; then   # inside test bot: only what needs attention
		printf '%s\n' "$out" | grep -aE '^(FAIL|SKIP|INFO summary) ' | sed 's/^/   /'
	else
		printf '%s\n' "$out" | grep -aE '^(PASS|FAIL|SKIP|INFO) ' | sed 's/^/   /'
	fi
	if printf '%s\n' "$out" | grep -aq 'Failed to runLuaFunction\|Exception in runLuaFunction'; then
		printf '%s\n' "$out" | grep -a 'runLuaFunction' | sed 's/^/   /'
		say "== lua: FAIL (function did not run — is custom_scripts/screenplays/fb_lab_tests.lua included?)"; return 1
	fi
	local pass fail
	pass=$(printf '%s\n' "$out" | grep -acE '^PASS ')
	fail=$(printf '%s\n' "$out" | grep -acE '^FAIL ')
	if (( pass == 0 )); then say "== lua: FAIL (no PASS lines seen)"; return 1; fi
	if (( fail > 0 )); then say "== lua: FAIL ($fail failed, $pass passed)"; return 1; fi
	say "== lua: PASS ($pass checks)"; return 0
}

# bot_name: "Lab" + 3 pronounceable consonant-vowel pairs. Random letter soup trips the server's
# name filter (e.g. "Labvartgm" -> name_declined_developer); CV syllables almost never do.
bot_name() {
	local c=bdfklmnprstv v=aeiou n="Lab" i
	for i in 1 2 3; do n+=${c:RANDOM%${#c}:1}${v:RANDOM%${#v}:1}; done
	printf '%s' "$n"
}

# bot_session create|reuse <char>: one core3client run; sets lua_rc, returns the client's exit code.
bot_session() {
	local mode=$1 char=$2
	local -a action
	if [ "$mode" = create ]; then
		action=(--create-character --char-name "$char" --char-race "${SWG_BOT_RACE:-object/creature/player/human_male.iff}" --char-profession "${SWG_BOT_PROF:-combat_marksman}")
	else
		action=(--character-firstname "$char")
	fi

	( cd "$BIN" && CORE3_CLIENT_PASSWORD="$(cat "$passfile")" ./core3client \
		--username "$user" --login-host "${SWG_LOGIN_HOST:-127.0.0.1}" --login-port "${SWG_LOGIN_PORT:-44453}" \
		"${action[@]}" --wait-after-zone "$wait" >"$clog" 2>&1 ) &
	local botpid=$!

	# once the server sees the character online, run the lua checks against it (the client's own
	# log is block-buffered when redirected, so it cannot be polled for progress)
	lua_rc=0
	local t0=$SECONDS
	while kill -0 "$botpid" 2>/dev/null && (( SECONDS - t0 < wait + 90 )); do
		if cmd_cmd "runLuaFunction FbLabTests:isOnline:$char" --timeout 5 2>/dev/null | grep -aq "^INFO online $char"; then
			sleep 3   # let the login finish populating containers before poking at them
			LAB_QUIET=1 test_lua "$char" || lua_rc=1
			break
		fi
		sleep 2
	done
	wait "$botpid"
}

test_bot() {
	require_running
	[ -x "$BIN/core3client" ] || die "$BIN/core3client missing — build with: CMAKE_ARGS=-DENABLE_BUILD_CLIENT=ON ~/bin/build"
	local user=${SWG_BOT_USER:-claude-player}
	# swg test bot [--user <account>] [--wait N]: a scenario that needs an admin bot runs it as claude-admin
	while [ $# -gt 0 ]; do
		case "$1" in
			--user) user=$2; shift 2 ;;
			*) break ;;
		esac
	done
	local passfile="$LABDIR/$user.pass"
	[ -r "$passfile" ] || die "no credentials at $passfile (swg account create $user 0)"
	local wait=${SWG_BOT_WAIT:-30}
	local clog="$LABDIR/last-bot.log"
	local err_before; err_before=$(count_errors)

	# The galaxy allows 10 characters per account; lab characters accumulate, so make room first.
	local total
	total=$(mysql -N "$DBNAME" -e "SELECT COUNT(*) FROM characters c JOIN accounts a ON a.account_id = c.account_id WHERE a.username = '$user'" 2>/dev/null || echo 0)
	if [ "${total:-0}" -ge 10 ]; then
		account_prune "$user" 6 || warn "could not prune $user's characters"
	fi

	# PlayerCreationManager allows admin_level < 9 accounts one new character per hour. When the
	# account created one recently, zone in as its newest Lab* character instead of failing.
	local recent newest
	recent=$(mysql -N "$DBNAME" -e "SELECT COUNT(*) FROM characters c JOIN accounts a ON a.account_id = c.account_id WHERE a.username = '$user' AND c.creation_date > NOW() - INTERVAL 1 HOUR" 2>/dev/null || echo 0)
	newest=$(mysql -N "$DBNAME" -e "SELECT c.firstname FROM characters c JOIN accounts a ON a.account_id = c.account_id WHERE a.username = '$user' AND c.firstname LIKE 'Lab%' ORDER BY c.character_oid DESC LIMIT 1" 2>/dev/null)

	local char mode
	if [ "${recent:-0}" != "0" ] && [ -n "$newest" ]; then
		char=$newest; mode=reuse
		say "== bot: $user zones in as existing '$char' (created one <1 h ago), waits ${wait}s, logs out"
	else
		# fresh character name each run so creation is exercised
		char=$(bot_name); mode=create
		say "== bot: $user creates '$char', zones in, waits ${wait}s, logs out"
	fi

	local rc lua_rc tries=0
	bot_session "$mode" "$char"; rc=$?
	# The name filter (scripts/managers/name/name_manager.lua) runs before the rate limit, so a
	# declined name costs nothing: pick another and try again.
	while (( rc != 0 && tries < 3 )) && [ "$mode" = create ] && grep -aq 'name_declined' "$clog"; do
		tries=$((tries + 1)); char=$(bot_name)
		say "   name declined by the server filter; retrying as '$char'"
		bot_session create "$char"; rc=$?
	done
	if (( rc != 0 )) && [ "$mode" = create ] && grep -aq 'one character per hour' "$clog" && [ -n "$newest" ]; then
		say "   creation rate-limited by the server; retrying as existing '$newest'"
		char=$newest
		bot_session reuse "$char"; rc=$?
	fi

	local err_after; err_after=$(count_errors)
	local new_errors=$((err_after - err_before))
	say "   core3client exit code: $rc   new server ERROR lines: $new_errors   (client log: $clog)"
	if (( new_errors > 0 )); then
		grep -aE '(ERROR|FATAL)' "$LOG" | grep -avE "$NOISE_RE" | tail -n "$new_errors" | strip_tty | sed 's/^/   /'
	fi
	if (( rc != 0 )); then
		grep -aiE 'error|fail|exception|timeout' "$clog" | tail -n 8 | sed 's/^/   /'
	fi
	if (( rc == 0 && new_errors == 0 && lua_rc == 0 )); then say "== bot: PASS"; return 0; fi
	say "== bot: FAIL"; return 1
}

test_scenario() {
	local name=${1:-all}
	require_running
	local -a files
	if [ "$name" = all ]; then
		files=("$REPO"/tools/scenarios/*.sh)
	elif [ -f "$REPO/tools/scenarios/$name.manual.sh" ]; then
		files=("$REPO/tools/scenarios/$name.manual.sh")
	else
		files=("$REPO/tools/scenarios/$name.sh")
	fi
	local rc=0 ran=0
	for f in "${files[@]}"; do
		[ "$(basename "$f")" = lib.sh ] && continue
		# *.manual.sh are long audits run by name only (swg test scenario <name>), never by "all"
		case "$(basename "$f")" in *.manual.sh) [ "$name" = all ] && continue ;; esac
		[ -f "$f" ] || die "no scenario $f"
		say "== scenario: $(basename "$f" .sh)"
		SWG="$REPO/tools/swg" bash "$f" 2>&1 | sed 's/^/   /' | tee "$LABDIR/last-scenario-$(basename "$f" .sh).log"
		local src=${PIPESTATUS[0]}
		if (( src != 0 )) && [ "$name" = all ]; then
			# a gate-wide run gives a red scenario one more go: the bot's conversation and loot heuristics flake now and
			# then (2026-10-23: three gates in a row red on one unrelated check each); a real bug fails twice
			cp "$LABDIR/last-scenario-$(basename "$f" .sh).log" "$LABDIR/last-scenario-$(basename "$f" .sh).first.log"
			say "== scenario: $(basename "$f" .sh) (red: one retry)"
			SWG="$REPO/tools/swg" bash "$f" 2>&1 | sed 's/^/   /' | tee "$LABDIR/last-scenario-$(basename "$f" .sh).log"
			src=${PIPESTATUS[0]}
			(( src == 0 )) && say "   (passed on the retry: a flake; the first run is in last-scenario-$(basename "$f" .sh).first.log)"
		fi
		(( src == 0 )) || rc=1
		ran=$((ran + 1))
	done
	(( ran > 0 )) || die "no scenarios found"
	say "== scenario: $( (( rc == 0 )) && echo PASS || echo FAIL ) ($ran run)"
	return $rc
}

# the site planner's data path (tools/siteplanner selftest): snapshot, shells, floor triangles, furniture,
# site-file parsing — headless, ~20 s, no server needed
test_planner() {
	say "== planner: tools/siteplanner selftest"
	if "$REPO/tools/siteplanner" selftest 2>&1 | sed 's/^/   /'; then say "== planner: PASS"; return 0; fi
	say "== planner: FAIL"; return 1
}

cmd_test() {
	local what=${1:-}; shift || true
	mkdir -p "$LABDIR"; chmod 700 "$LABDIR"
	case "$what" in
		unit) test_unit "$@" ;;
		lua)  test_lua "$@" ;;
		bot)  test_bot "$@" ;;
		scenario) test_scenario "$@" ;;
		planner) test_planner ;;
		all)
			local rc=0
			if is_running; then say "== all: stopping the running server for unit tests"; cmd_stop || exit 1; fi
			test_unit || rc=1
			test_planner || rc=1
			cmd_start || exit 1
			# a natural sandstorm on Tatooine (3.9) sends Tusken raiders to the outskirts where scenarios park their
			# characters (2026-10-21: one storm killed the gate's character and failed ten scenarios in a row)
			say "== all: clear skies on tatooine for the run"; cmd_cmd "runLuaFunction FbLabTests:weatherSet:tatooine:0" >/dev/null 2>&1 || true
			test_lua || rc=1
			test_bot || rc=1
			test_scenario all || rc=1
			say "== all: $( (( rc == 0 )) && echo PASS || echo FAIL )  (server left running)"
			if (( rc == 0 )); then git -C "$BENCH" rev-parse HEAD >>"$LABDIR/gate.passed" 2>/dev/null; fi
			return $rc ;;
		*) die "usage: swg test unit|lua|bot|scenario <name>|planner|all" ;;
	esac
}

# ---------------------------------------------------------------- build

cmd_build() { build_inner "$@"; local rc=$?; (( rc == 0 )) && bench_note_built; return $rc; }
build_inner() {
	mkdir -p "$LABDIR"
	local log="$LABDIR/last-build.log" t0=$SECONDS
	say "== build: ~/bin/build (client on) → $log"
	( cd "$REPO" && CMAKE_ARGS="-DENABLE_BUILD_CLIENT=ON ${CMAKE_ARGS:-}" "$HOME/bin/build" "$@" ) >"$log" 2>&1
	local rc=$?
	local errors; errors=$(grep -ac "error:" "$log")
	local warnings; warnings=$(grep -ac "warning:" "$log")
	if (( rc != 0 || errors > 0 )); then
		grep -aE -B2 -A6 "error:" "$log" | head -n 80
		say "== build: FAIL (rc=$rc, $errors error(s), $((SECONDS - t0))s)"
		return 1
	fi
	(( warnings > 0 )) && grep -a "warning:" "$log" | grep -a "MMOCoreORB/src" | head -n 10
	say "== build: OK ($warnings warning(s), $((SECONDS - t0))s)  core3 $(date -r "$BIN/core3" '+%T')  core3client $(date -r "$BIN/core3client" '+%T' 2>/dev/null || echo missing)"
	is_running && say "   server is running an older binary — swg restart to pick it up"
	return 0
}

# ---------------------------------------------------------------- snapshots

snap_name_ok() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }

cmd_snap() {
	local op=${1:-}; local name=${2:-}; shift 2 2>/dev/null || true
	case "$op" in
		list)
			[ -d "$SNAPDIR" ] || { say "no snapshots in $SNAPDIR"; return 0; }
			for d in "$SNAPDIR"/*/; do
				[ -f "$d/meta.txt" ] || continue
				printf '%-24s %8s  %s\n' "$(basename "$d")" "$(du -sh "$d" | cut -f1)" "$(grep -a '^when' "$d/meta.txt" | cut -d' ' -f2-) $(grep -a '^rev' "$d/meta.txt" | cut -d' ' -f2-)"
			done ;;
		save)
			[ -n "$name" ] && snap_name_ok "$name" || die "usage: swg snap save <name>   (letters, digits, . _ -)"
			require_stopped
			local dest="$SNAPDIR/$name"
			if [ -e "$dest" ]; then
				[ "${1:-}" = "--force" ] || die "$dest exists (use --force to overwrite)"
				rm -rf "$dest"
			fi
			mkdir -p "$dest"
			say "snap save '$name' -> $dest"
			mysqldump --single-transaction --quick --routines "$DBNAME" | gzip -1 > "$dest/swgemu.sql.gz" || { rm -rf "$dest"; die "mysqldump failed"; }
			cp -a "$BIN/databases" "$dest/databases" || { rm -rf "$dest"; die "copy of bin/databases failed"; }
			{
				echo "when $(date '+%F %T')"
				echo "rev $(git_branch)@$(git_rev)"
				echo "core3 $(date -r "$BIN/core3" '+%F %T' 2>/dev/null)"
				echo "mysql $(gzip -dc "$dest/swgemu.sql.gz" | wc -c) bytes uncompressed"
				echo "databases $(du -sh "$dest/databases" | cut -f1)"
			} > "$dest/meta.txt"
			cat "$dest/meta.txt" | sed 's/^/   /'
			say "done ($(du -sh "$dest" | cut -f1))" ;;
		load)
			[ -n "$name" ] && snap_name_ok "$name" || die "usage: swg snap load <name> --yes"
			local src="$SNAPDIR/$name"
			[ -f "$src/meta.txt" ] && [ -f "$src/swgemu.sql.gz" ] && [ -d "$src/databases" ] || die "no complete snapshot at $src"
			require_stopped
			if [ "${1:-}" != "--yes" ]; then
				say "This replaces the MySQL database '$DBNAME' AND $BIN/databases with snapshot '$name':"
				sed 's/^/   /' "$src/meta.txt"
				die "re-run with --yes to proceed (ask Chuck first)"
			fi
			say "snap load '$name': restoring MySQL"
			gzip -dc "$src/swgemu.sql.gz" | mysql "$DBNAME" || die "mysql restore failed"
			say "snap load '$name': restoring bin/databases"
			rm -rf "$BIN/databases"
			cp -a "$src/databases" "$BIN/databases" || die "copy failed"
			# navmeshes/exports regenerate; ODB environment files come with the snapshot
			say "done" ;;
		*) die "usage: swg snap save|load|list <name>" ;;
	esac
}

# ---------------------------------------------------------------- accounts

# account_prune <user> <keep>: move the oldest Lab* characters of a claude-* account into
# deleted_characters and drop them from characters (the login server's DeleteCharacter SQL); the zone
# server purges their objects on its own schedule. Characters must be offline.
account_prune() {
	local user=$1 keep=${2:-4}
	[[ "$user" =~ ^claude-(player|admin)$ ]] || die "prune: only the lab accounts claude-player / claude-admin"
	[[ "$keep" =~ ^[0-9]+$ ]] || die "prune: --keep needs a number"
	local acct; acct=$(mysql -N "$DBNAME" -e "SELECT account_id FROM accounts WHERE username = '$user'") || die "prune: mysql failed"
	[ -n "$acct" ] || die "prune: no account $user"
	local oids; oids=$(mysql -N "$DBNAME" -e "SELECT character_oid FROM characters WHERE account_id = $acct AND firstname LIKE 'Lab%' ORDER BY character_oid DESC LIMIT 1000 OFFSET $keep")
	local n=0 oid
	for oid in $oids; do
		if is_running && cmd_cmd "runLuaFunction FbLabTests:isOnline:$(mysql -N "$DBNAME" -e "SELECT firstname FROM characters WHERE character_oid = $oid")" --timeout 5 2>/dev/null | grep -aq '^INFO online'; then
			warn "prune: $oid is online, skipped"; continue
		fi
		mysql swgemu -e "INSERT INTO deleted_characters SELECT *, 0 AS db_deleted FROM characters WHERE character_oid = $oid AND account_id = $acct; DELETE FROM characters WHERE character_oid = $oid AND account_id = $acct;" || die "prune: delete of $oid failed"
		n=$((n + 1))
	done
	say "== prune: $user: $n Lab* character(s) deleted, $keep newest kept"
}

cmd_account() {
	local op=${1:-}; shift || true
	case "$op" in
		create)
			local user=${1:-} level=${2:-} reset=0
			[ "${3:-}" = "--reset" ] && reset=1
			[[ "$user" =~ ^[A-Za-z0-9_.-]{3,32}$ ]] || die "usage: swg account create <user> <admin_level> [--reset]"
			[[ "$level" =~ ^[0-9]+$ ]] && (( level <= 15 )) || die "admin_level must be 0..15"
			mkdir -p "$LABDIR"; chmod 700 "$LABDIR"

			# Same recipe as AccountManager::createAccount():
			#   salt = 32 hex chars, password column = SHA256(DBSecret + password + salt) as lowercase hex
			local secret pass salt hash station exists
			secret=$(dbsecret)
			pass=$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-20)
			salt=$(openssl rand -hex 16)
			hash=$(printf '%s%s%s' "$secret" "$pass" "$salt" | sha256sum | cut -d' ' -f1)
			station=$(( (RANDOM << 15 | RANDOM) + 1 ))
			exists=$(mysql -N "$DBNAME" -e "SELECT COUNT(*) FROM accounts WHERE username='$user'")
			if [ "$exists" != "0" ]; then
				(( reset == 1 )) || die "account '$user' exists (use --reset to set a new password / level)"
				mysql swgemu -e "UPDATE accounts SET password='$hash', salt='$salt', admin_level=$level, active=1 WHERE username='$user'" || die "update failed"
			else
				mysql swgemu -e "INSERT INTO accounts (username, password, station_id, salt, admin_level) VALUES ('$user','$hash',$station,'$salt',$level)" || die "insert failed"
			fi
			( umask 077; printf '%s' "$pass" > "$LABDIR/$user.pass" )
			mysql swgemu -e "SELECT account_id, username, admin_level, active, created FROM accounts WHERE username='$user'"
			say "password written to $LABDIR/$user.pass (not in the repo)" ;;
		list) mysql swgemu -e "SELECT account_id, username, admin_level, active, created FROM accounts" ;;
		prune)
			local user=${2:-} keep=4
			[ "${3:-}" = "--keep" ] && keep=${4:-4}
			[ -n "$user" ] || die "usage: swg account prune <user> [--keep N]"
			account_prune "$user" "$keep"
			;;
		*) die "usage: swg account create <user> <admin_level> [--reset] | prune <user> [--keep N] | list" ;;
	esac
}

# ---------------------------------------------------------------- main

# swg site save <char> <name> [--force]  → write the character's exported site draft (Lab Remote → Site
# builder → Export) into screenplays/tasks/sites/<name>.lua; the next start builds it. Review + commit as usual.
cmd_site() {
	local sub=${1:-}; shift || true
	case "$sub" in
		save)
			local char=${1:-} name=${2:-} force=0
			[ -n "$char" ] && [ -n "$name" ] || die "usage: swg site save <char> <name> [--force]"
			[ "${3:-}" = "--force" ] && force=1
			name=$(printf '%s' "$name" | tr -c 'a-z0-9_\n' '_')
			local out="$REPO/MMOCoreORB/bin/scripts/screenplays/tasks/sites/$name.lua"
			if [ -f "$out" ] && [ "$force" != 1 ]; then die "$out exists (use --force to replace it)"; fi
			require_running
			local text
			text=$("$0" cmd "runLuaFunction FbLabTests:siteText:$char" --timeout 10 | sed -n 's/^INFO sitefile //p')
			grep -q '^FbSites:add {' <<<"$text" || die "no draft text for $char (export it from the remote's Site builder first)"
			mkdir -p "$(dirname "$out")"
			printf '%s\n' "$text" | sed "s/name = \"[^\"]*\"/name = \"$name\"/" > "$out"
			say "wrote $out ($(wc -l < "$out") lines). Restart (swg restart / test all) to build it; then review and commit."
			;;
		list)
			ls -1 "$REPO/MMOCoreORB/bin/scripts/screenplays/tasks/sites/" 2>/dev/null | sed 's/\.lua$//' ;;
		*) die "usage: swg site save <char> <name> [--force] | swg site list" ;;
	esac
}

cmd_tre() {
	[ -x "$TRE" ] || die "$TRE missing"
	case "${1:-}" in
		build|install|patchcfg|status|list|extract|strings|verify|roundtrip|crc) exec "$TRE" "$@" ;;
		*) die "usage: swg tre build|install [--client DIR]|patchcfg FILE|status|list|extract|strings|verify|roundtrip|crc" ;;
	esac
}

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' | sed '1d'; }

# ---------------------------------------------------------------- swg live init|deploy|client|status (run on the bench)

live_sql_hint() {
	cat >&2 <<EOT
the MySQL database '$1' does not exist or is not reachable as user swgemu. Chuck creates it once (root):
  ! sudo mysql -e "CREATE DATABASE $1 CHARACTER SET utf8mb4; GRANT ALL PRIVILEGES ON $1.* TO 'swgemu'@'%'; FLUSH PRIVILEGES;"
then: swg live init
EOT
}

live_config_local() {
	# the bench's config-local.lua with the live instance's database, ports and archive folder; the secret and the rest stay
	local src="$BENCH/MMOCoreORB/bin/conf/config-local.lua" dst="$LIVE_ROOT/bin/conf/config-local.lua"
	[ -f "$src" ] || die "$src missing (the bench's local config holds the DB credentials)"
	local base=$LIVE_PORT_BASE
	# top-level statements, so no trailing commas (the first version wrote them and the server booted with no config at all)
	sed -e "s|^\([[:space:]]*\)DBName[[:space:]]*=.*|\1DBName = \"swgemu_live\"|" \
	    -e "s|^\([[:space:]]*\)LoginPort[[:space:]]*=.*|\1LoginPort = $((base + 453))|" \
	    -e "s|^\([[:space:]]*\)PingPort[[:space:]]*=.*|\1PingPort = $((base + 462))|" \
	    -e "s|^\([[:space:]]*\)StatusPort[[:space:]]*=.*|\1StatusPort = $((base + 455))|" \
	    -e "s|^\([[:space:]]*\)ZoneServerPort[[:space:]]*=.*|\1ZoneServerPort = $((base + 463))|" \
	    -e "s|^\([[:space:]]*\)TrePath[[:space:]]*=.*|\1TrePath = \"$LIVE_ROOT/tre\"|" "$src" > "$dst"
	# the Core3 table entries too (the top-level names are read for some settings only), after the table exists
	cat >> "$dst" <<EOT

-- the live instance (written by swg live init): its own database, ports and archive folder
Core3.DBName = "swgemu_live"
Core3.LoginPort = $((base + 453))
Core3.PingPort = $((base + 462))
Core3.StatusPort = $((base + 455))
Core3.ZoneServerPort = $((base + 463))
Core3.ORBPort = $((base + 419))
Core3.WebPorts = $((base + 460))
Core3.MetricsPort = 0
Core3.TrePath = "$LIVE_ROOT/tre"
EOT
	chmod 600 "$dst"
	luac -p "$dst" 2>/dev/null || die "$dst does not parse (luac -p); the server would boot with no config"
}

live_tre_links() {
	mkdir -p "$LIVE_ROOT/tre"
	local f
	for f in /tre/*.tre; do
		[ "$(basename "$f")" = finalboss.tre ] && continue
		[ -e "$LIVE_ROOT/tre/$(basename "$f")" ] || ln -s "$f" "$LIVE_ROOT/tre/$(basename "$f")"
	done
}

live_sync_runtime() {
	# binaries, scripts and the shared conf from the bench; never its local config, ODB or logs
	mkdir -p "$LIVE_ROOT/bin/conf" "$LIVE_ROOT/bin/log"
	rsync -a --delete "$BENCH/MMOCoreORB/bin/scripts/" "$LIVE_ROOT/bin/scripts/" || die "rsync scripts failed"
	rsync -a --exclude config-local.lua "$BENCH/MMOCoreORB/bin/conf/" "$LIVE_ROOT/bin/conf/" || die "rsync conf failed"
	# the generated data too: without the navmeshes the live server rebuilds every one at boot (1.3 GB on the bench)
	local d
	for d in navmeshes terrain; do [ -d "$BENCH/MMOCoreORB/bin/$d" ] && { rsync -a "$BENCH/MMOCoreORB/bin/$d/" "$LIVE_ROOT/bin/$d/" || die "rsync $d failed"; }; done
	cp -p "$BENCH/MMOCoreORB/bin/core3" "$LIVE_ROOT/bin/core3" || die "copy of core3 failed"
	[ -x "$BENCH/MMOCoreORB/bin/core3client" ] && cp -p "$BENCH/MMOCoreORB/bin/core3client" "$LIVE_ROOT/bin/core3client"
	local src="$BENCH/MMOCoreORB/bin/tre/finalboss.tre" dst="$LIVE_ROOT/tre/finalboss.tre"
	[ -f "$src" ] || src=/tre/finalboss.tre
	if [ -f "$src" ] && ! cmp -s "$src" "$dst" 2>/dev/null; then
		cp -p "$src" "$dst" && touch "$LIVE_RELOAD_MARK" && say "finalboss.tre deployed (reloadstrings at the next live start)"
	fi
	git -C "$BENCH" describe --always --dirty --abbrev=10 > "$LIVE_ROOT/DEPLOYED" 2>/dev/null
	date '+%F %T' >> "$LIVE_ROOT/DEPLOYED"
}

live_running() { local p want; want=$(readlink -f "$LIVE_ROOT/bin" 2>/dev/null); for p in $(pgrep -x core3); do [ "$(readlink -f "/proc/$p/cwd" 2>/dev/null)" = "$want" ] && return 0; done; return 1; }

cmd_live() {
	[ "$INSTANCE" = bench ] || die "swg live … runs on the bench (without --live)"
	case "${1:-}" in
		init)
			shift
			mysql -N swgemu_live -e 'SELECT 1' >/dev/null 2>&1 || { live_sql_hint swgemu_live; die "live init: no database"; }
			[ -d "$LIVE_ROOT/bin/databases" ] && [ "${1:-}" != "--force" ] && die "$LIVE_ROOT already has an ODB (use --force to replace it from the bench)"
			require_stopped
			live_running && die "the live core3 is running: swg --live stop first"
			say "== live init: $LIVE_ROOT from the bench ($(git -C "$BENCH" rev-parse --abbrev-ref HEAD) @ $(git -C "$BENCH" rev-parse --short HEAD))"
			mkdir -p "$LIVE_ROOT/bin" "$LIVE_ROOT/tre"
			live_tre_links
			live_sync_runtime
			live_config_local
			say "MySQL: swgemu -> swgemu_live (every account, character and the galaxy row)"
			mysqldump --single-transaction --quick --routines swgemu | mysql swgemu_live || die "copy of the database failed"
			mysql swgemu_live -e "UPDATE galaxy SET port = $((LIVE_PORT_BASE + 463)), pingport = $((LIVE_PORT_BASE + 462)) WHERE galaxy_id = (SELECT * FROM (SELECT MIN(galaxy_id) FROM galaxy) g)" || die "galaxy row update failed"
			say "ODB: $BENCH/MMOCoreORB/bin/databases -> $LIVE_ROOT/bin/databases ($(du -sh "$BENCH/MMOCoreORB/bin/databases" | cut -f1))"
			rm -rf "$LIVE_ROOT/bin/databases"
			cp -a "$BENCH/MMOCoreORB/bin/databases" "$LIVE_ROOT/bin/databases" || die "copy of the ODB failed"
			touch "$LIVE_RELOAD_MARK"
			say "live instance ready: swg --live start   (login port $((LIVE_PORT_BASE + 453)); swg live client points the game client at it)"
			;;
		deploy)
			shift
			local restart=1; [ "${1:-}" = "--no-restart" ] && restart=0
			[ -d "$LIVE_ROOT/bin" ] || die "no live instance at $LIVE_ROOT (swg live init)"
			[ "$(git -C "$BENCH" rev-parse --abbrev-ref HEAD)" = unstable ] || die "the bench is on $(git -C "$BENCH" rev-parse --abbrev-ref HEAD), not unstable: swg bench use unstable first"
			[ -z "$(git -C "$BENCH" status --porcelain)" ] || die "the bench checkout is dirty"
			local built; built=$(cat "$(bench_built_file)" 2>/dev/null || true)
			[ "$built" = "$(git -C "$BENCH" rev-parse HEAD)" ] || die "the bench binary is not built from this commit (swg bench use unstable builds it)"
			say "== live deploy: unstable @ $(git -C "$BENCH" rev-parse --short HEAD) -> $LIVE_ROOT"
			if live_running && [ "$restart" = 1 ]; then say "stopping the live core3"; SWG_INSTANCE=live "$0" stop || die "live stop failed"; fi
			live_sync_runtime
			if [ "$restart" = 1 ]; then SWG_INSTANCE=live "$0" start || die "live start failed"; else say "deployed; the live core3 picks it up at its next restart (swg --live restart)"; fi
			;;
		sync)
			# whatever the bench has right now, no branch check (deploy is the checked path); the live server reads it at its next start
			[ -d "$LIVE_ROOT/bin" ] || die "no live instance at $LIVE_ROOT (swg live init)"
			live_running && die "the live core3 is running: swg --live stop first, or use swg live deploy"
			live_sync_runtime && say "synced from the bench @ $(git -C "$BENCH" rev-parse --short HEAD); swg --live start"
			;;
		config)
			[ -d "$LIVE_ROOT/bin/conf" ] || die "no live instance at $LIVE_ROOT (swg live init)"
			live_config_local && say "$LIVE_ROOT/bin/conf/config-local.lua regenerated (restart the live core3 to read it)"
			;;
		client)
			shift
			local dir cfg port
			dir=$(cat "$LABDIR/client-dir" 2>/dev/null) || die "no client folder remembered (swg tre install --client DIR first)"
			cfg="$dir/swgemu_login.cfg"; [ -f "$cfg" ] || die "$cfg missing"
			port=$((LIVE_PORT_BASE + 453)); [ "${1:-}" = "--bench" ] && port=44453
			grep -q '^loginServerPort0=' "$cfg" || die "$cfg has no loginServerPort0 line"
			cp -p "$cfg" "$cfg.swg.bak"
			sed -i "s/^loginServerPort0=.*/loginServerPort0=$port/" "$cfg"
			say "$cfg: loginServerPort0=$port ($( [ "$port" = 44453 ] && echo 'the bench' || echo 'the live instance')); restart the game client"
			;;
		status|"")
			say "bench  $( is_running && echo "RUNNING pid $(core3_pid)" || echo STOPPED )  $BENCH @ $(git -C "$BENCH" rev-parse --short HEAD) ($(git -C "$BENCH" rev-parse --abbrev-ref HEAD))  login 44453"
			if [ -d "$LIVE_ROOT/bin" ]; then
				say "live   $( live_running && echo "RUNNING pid $(SWG_INSTANCE=live "$0" status 2>/dev/null | sed -n 's/.*pid \([0-9]*\).*/\1/p' | head -n1)" || echo STOPPED )  $LIVE_ROOT  deployed $(head -n1 "$LIVE_ROOT/DEPLOYED" 2>/dev/null || echo '?') ($(sed -n 2p "$LIVE_ROOT/DEPLOYED" 2>/dev/null))  login $((LIVE_PORT_BASE + 453))  db swgemu_live"
			else
				say "live   not set up (swg live init)"
			fi
			[ -f "$LABDIR/client-dir" ] && say "client $(grep -h '^loginServerPort0=' "$(cat "$LABDIR/client-dir")/swgemu_login.cfg" 2>/dev/null | head -n1 || echo '?')  ($(cat "$LABDIR/client-dir"))"
			;;
		*) die "usage: swg live init [--force] | deploy [--no-restart] | sync | config | client [--bench] | status" ;;
	esac
}

restart_inner() { cmd_stop && cmd_start "$@"; }
if [ "$INSTANCE" = live ]; then
	case "${1:-}" in
		bench|test|build|agent|site|tre) die "swg --live $1: gates, deploys and builds run on the bench; the live instance takes 'swg live deploy'" ;;
	esac
fi
case "${1:-}" in
	live)    shift; cmd_live "$@" ;;
	start)   shift; with_lock "start" cmd_start "$@"; bench_note_running ;;
	stop)    shift; with_lock "stop" cmd_stop "$@" ;;
	restart) shift; with_lock "restart" restart_inner "$@"; bench_note_running ;;
	status)  cmd_status ;;
	cmd)     shift; if [ "${1:-}" = "--shared" ]; then cmd_cmd "$@"; else with_lock "console: ${1:-}" cmd_cmd "$@"; fi ;;
	logs)    shift; cmd_logs "$@" ;;
	test)    shift; with_lock "test ${1:-} ${2:-}" cmd_test "$@" ;;
	build)   shift; with_lock "build" cmd_build "$@" ;;
	snap)    shift; with_lock "snap ${1:-}" cmd_snap "$@" ;;
	account) shift; cmd_account "$@" ;;
	tre)     shift; if [ "${1:-}" = install ]; then with_lock "tre install" cmd_tre "$@"; else cmd_tre "$@"; fi ;;
	site)    shift; with_lock "site ${1:-}" cmd_site "$@" ;;
	whoami)  cmd_whoami ;;
	lock)    shift; cmd_lock "$@" ;;
	unlock)  shift; cmd_unlock "$@" ;;
	agent)   shift; cmd_agent "$@" ;;
	bench)   shift; cmd_bench "$@" ;;
	-h|--help|help|"") usage ;;
	*) die "unknown command '$1' (swg --help)" ;;
esac
