#!/usr/bin/env python3
"""
tools/seat — drive a seat: a core3client kept logged in as one character, serving a JSON-lines
control channel on a unix socket (SeatAction, Phase 7.0). A pilot (7.3) sits on top of this.

  seat start <user> <char> [--timeout S] [--name N]   log the character in and open the channel
                                                        (password from ~/.swg-lab/<user>.pass; seat name defaults to the character)
  seat stop <name>                                     ask the seat to quit (logout follows) and wait for the client to exit
  seat list                                            seats with a live socket
  seat prune [--all]                                   remove the state directories of dead scenario seats (lab*-NNNN; start does this
                                                        too); --all removes every dead seat's directory, named citizens included
  seat ping <name>                                     round trip
  seat send <name> '<json request>'                    raw request, prints the reply
  seat do <name> <action> [key=value …]                {"op":"action","action":{"action":<action>,…}}; values parse as JSON when they can
  seat say <name> <text> | tell <name> <who> <text> | emote <name> <emote> [target]
  seat cmd <name> <command> [args] [--target oid] [--nowait]
  seat vars <name> [path]                              the client's var store (SpatialChat, SystemMessages, Tells, Sui, …)
  seat objects <name> [--near]                         what the client has in view (creation positions)
  seat wait <name> <signal> [timeoutMs]                block until that packet arrives (SpatialChat, Tell, SuiCreatePage, …)
  seat walk <name> <x> <y> [--cell OID] [--speed M/S] ask the server for a path from where the character stands and walk it
                                                        (real movement packets; the route comes from FbLabTests:pathTo over swg cmd --shared;
                                                        --cell makes x,y cell-local: a spot inside a building, e.g. a starport's ticket terminal)
  seat where <name>                                    the character's server-side position (FbLabTests:where)
  seat points <planet>                                 the planet's travel points with their ticket terminal and shuttle (FbLabTests:travelPoints)
  seat travel <name> <planet> <point> [--from POINT] [--round-trip] [--wait S]
                                                        a whole trip: walk to the nearest (or --from) travel point's terminal, buy the ticket,
                                                        walk to the shuttle, board it (waiting for it to land, up to --wait s, default 240),
                                                        and report where the character arrived. Point names take underscores for spaces.
  seat ticket <name> <fromPlanet> <fromPoint> <toPlanet> <toPoint> [--round-trip]   the purchase alone (stand by a terminal)
  seat board <name> [ticket oid] [--wait S]            the boarding alone (stand by the shuttle)
  seat place <name> <deed oid> <x> <y> [angle 0-3]     placeStructure from a deed in the inventory (within 100 m, outdoors,
                                                        outside cities); prints the new structure's oid
  seat harvester <name> <oid> resources                what this harvester could extract here, with density %
  seat harvester <name> <oid> select <spawn oid> | activate | deactivate | maintain <credits> | power <units>
  seat harvester <name> <oid> empty <spawn oid> <units> [--discard]   the hopper into the inventory
  seat harvester <name> <oid> status                   the server-side view (FbLabTests:harvester: hopper, maintenance, power)
  seat survey <name> <tool oid> <resource> [range]    use the survey tool, survey that resource, print the grid's best point
  seat sample <name> <resource> [rounds]               sample where the character stands (3 s, then 25 s per extra round;
                                                        answers the 1-in-51 concentrated-sample window and retries)
  seat resources <planet> [class]                      the resource oracle (FbLabTests:resources over swg cmd --shared)
  seat log <name> [lines]                              tail of the client log
  seat fight <name> <target oid> [--max S] [--reach M]  close to --reach m (default 4: melee; a rifle allows ~60), attack and keep swinging
  seat sell <name> <item oid> <terminal oid> <price> [--describe TEXT]   list the item on a bazaar terminal for an instant sale (status 0 = listed)
  seat retrieve <name> <item oid> <terminal oid>        take a listing back into the inventory (within 8 m)
                                                        (defaultattack every 3 s) until it is dead or --max s (90) pass, re-closing when the
                                                        server says out of range, then loot all from the corpse; prints a verdict line
  seat templates                                       (re)write ~/.swg-lab/templates.jsonl, the client's object type/name table, from the
                                                        server's loaded templates (FbLabTests:templateDump); start does it when the file is missing

State per seat lives in ~/.swg-lab/seats/<name>/: sock, pid, client.log.
"""
import json
import os
import re
import socket
import subprocess
import sys
import time

LABDIR = os.environ.get("SWG_LABDIR", os.path.expanduser("~/.swg-lab"))
SEATS = os.path.join(LABDIR, "seats")
HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)

# the server and its client live in the bench (the main checkout), not in an agent's worktree
def bench():
    try:
        out = subprocess.run(["git", "-C", REPO, "worktree", "list", "--porcelain"], capture_output=True, text=True).stdout
        first = out.splitlines()[0]
        if first.startswith("worktree "):
            return first[len("worktree "):]
    except Exception:
        pass
    return REPO

BIN = os.path.join(bench(), "MMOCoreORB", "bin")

# social emotes by canonical name -> row number of datatables/chat/social_types.iff (1-based, the ids
# ChatManager::loadSocialTypes assigns); tools/seat_emotes.json is generated from the stock table
