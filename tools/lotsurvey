#!/usr/bin/env python3
"""
lotsurvey — where can a building go, and where are the rooms inside it? (Final Boss, Phase 2.11)

Reads the stock client data straight from the server's archives (TrePath + Core3.TreFiles order, via
tools/tre), so it answers from the same files the client renders:

  lotsurvey near PLANET X Y [RADIUS]             world-snapshot objects around a point (buildings first)
  lotsurvey cells PLANET X Y                      the building at a point and its cell object ids
                                                  (those ids are what city screenplays spawn into)
  lotsurvey footprint TEMPLATE                    a building template's exterior floor extents (local x/z)
  lotsurvey rooms TEMPLATE                        each cell: name, cell-local x/y range, floor height z
  lotsurvey furniture TEMPLATE [ROOM]             the client-only furniture inside (interior layout .ilf)
  lotsurvey check TEMPLATE --lua SCREENPLAY | --spot ROOM,X,Y …
                                                  are these standing spots clear of the furniture?
  lotsurvey export [--planets a,b,…] [--out FILE] generate custom_scripts/fb_world_data.lua for the server
  lotsurvey lots PLANET X Y [RADIUS] [--template T | --width W --back B --front F]
                                                  free lots nearest the point for a building of that size,
                                                  clear of every stock footprint; prints origin + heading

Formats (from the server's own readers, see docs/dev-notes.md 2026-10-18):
  .ws  WSNP > <ver> > NODS > NODE > <ver> > DATA(objectID, parentID, nameID, cellIndex, quat wxyz,
       x z y, type, unknown) + child NODEs; then OTNL(count, names). IFF sizes big-endian, payload little.
  .iff object template: strings only (portal layout .pob file name).
  .pob portal layout: strings only (per-room floor .flr names, in cell order; r0 = exterior).
  .flr floor mesh: VERT chunk (count, count x (x, height, z) floats). Cell-local server coordinates are
       (x, floor height, z) -> Lua spawn (x, z=height, y=meshZ).
  .ilf interior layout (client only — the server never sees this furniture): NODE chunks, each a prop
       template C string, a cell-name C string and a 3x4 matrix (row-major; translation x, height, z).
  prop boxes: template .iff -> .apt -> .lod/.msh, first BOX chunk (6 floats: two corners).
"""
import argparse, importlib.util, math, os, re, struct, sys

HERE = os.path.dirname(os.path.abspath(__file__))
_spec = importlib.util.spec_from_loader("fbtre", loader=None)
fbtre = importlib.util.module_from_spec(_spec)
fbtre.__file__ = os.path.join(HERE, "tre")   # tools/tre derives the repo root from its own path
with open(fbtre.__file__, encoding="utf-8") as _fh:
    exec(compile(_fh.read(), fbtre.__file__, "exec"), fbtre.__dict__)


class Vfs:
    """The client's view of the data: first archive in Core3.TreFiles that has a path wins."""

    def __init__(self):
        self.tre_dir = fbtre.tre_path_from_config()
        with open(fbtre.CONFIG_MAIN, encoding="utf-8", errors="replace") as fh:
            m = re.search(r"TreFiles\s*=\s*\{([^}]*)\}", fh.read(), re.S)
        self.files = re.findall(r'"([^"]+)"', m.group(1)) if m else []
        self._recs = {}

    def _records(self, name):
        if name not in self._recs:
            path = os.path.join(self.tre_dir, name)
            try:
                with open(path, "rb") as fh:
                    recs = fbtre.tre_read(fh.read())
                self._recs[name] = {r.name: r for r in recs}
            except (OSError, ValueError):
                self._recs[name] = {}
        return self._recs[name]

    def read(self, path):
        for name in self.files:
            rec = self._records(name).get(path)
            if rec is not None:
                return rec.data()
        raise FileNotFoundError(path)


def iff_strings(blob, minlen=5):
    return [s.decode("ascii") for s in re.findall(rb"[\x20-\x7e]{%d,}" % minlen, blob)]


# ---------------------------------------------------------------- world snapshot

def read_snapshot(vfs, planet):
    data = vfs.read("snapshot/%s.ws" % planet)
    nodes, names = [], []

    def form(pos):
        return data[pos:pos + 4], struct.unpack(">I", data[pos + 4:pos + 8])[0], pos + 8

    def node(pos):
        tag, size, p = form(pos)
        assert tag == b"FORM" and data[p:p + 4] == b"NODE", (tag, data[p:p + 4])
        end = p + size
        p += 4
        tag, size, p = form(p)
        ver_end = p + size
        p += 4
        assert data[p:p + 4] == b"DATA"
        csize = struct.unpack(">I", data[p + 4:p + 8])[0]
        f = struct.unpack("<IIIIfffffffffI", data[p + 8:p + 8 + 56])
        oid, parent, nameid, cellidx = f[0:4]
        qw, qx, qy, qz = f[4:8]
        x, z, y = f[8:11]
        nodes.append(dict(oid=oid, parent=parent, nameid=nameid, cell=cellidx, x=x, y=y, z=z,
                          heading=math.degrees(2 * math.atan2(qy, qw)) % 360))
        p += 8 + csize
        while p < ver_end:
            p = node(p)
        return end

    tag, size, p = form(0)
    assert data[p:p + 4] == b"WSNP", "not a world snapshot"
    p += 4
    tag, size, p = form(p)
    p += 4
    tag, size, p = form(p)
    assert data[p:p + 4] == b"NODS"
    nods_end = p + size
    p += 4
    while p < nods_end:
        p = node(p)
    assert data[nods_end:nods_end + 4] == b"OTNL"
    q = nods_end + 8
    count = struct.unpack("<I", data[q:q + 4])[0]
    q += 4
    for _ in range(count):
        e = data.index(b"\0", q)
        names.append(data[q:e].decode())
        q = e + 1
    for n in nodes:
        n["name"] = names[n["nameid"]]
    return nodes


# ---------------------------------------------------------------- templates, layouts, floors

def pob_of(vfs, template):
    strings = iff_strings(vfs.read(template))
    pobs = [s for s in strings if s.endswith(".pob")]
    return pobs[0] if pobs else None


def floors_of(vfs, pob):
    """[(room index, room name, floor path)] in portal-layout order; index 0 is the exterior."""
    out = []
    for s in iff_strings(vfs.read(pob)):
        m = re.search(r"_r(\d+)_(?:([a-z0-9]+)_)?collision_floor\d*\.flr$", s)   # exteriors may carry no room name
        if m:
            out.append((int(m.group(1)), m.group(2) or ("exterior" if m.group(1) == "0" else "r" + m.group(1)), s))
    return sorted(out)


def floor_extents(vfs, path):
    """Vertices of a floor mesh. FLOR versions 0003/0005 store the VERT chunk as bare floats; 0006 prefixes
    a count (templates/appearance/FloorMesh.cpp) — tell them apart by the chunk size."""
    d = vfs.read(path)
    i = d.find(b"VERT")
    size = struct.unpack(">I", d[i + 4:i + 8])[0]
    p = i + 8
    n0 = struct.unpack("<I", d[p:p + 4])[0] if size >= 4 else 0
    if size >= 4 and 4 + 12 * n0 == size:
        n = n0
        p += 4
    else:
        n = size // 12
    v = [struct.unpack("<fff", d[p + 12 * k:p + 12 * k + 12]) for k in range(n)]
    xs, hs, zs = [a for a, b, c in v], [b for a, b, c in v], [c for a, b, c in v]
    return dict(verts=n, x0=min(xs), x1=max(xs), h0=min(hs), h1=max(hs), z0=min(zs), z1=max(zs))


def footprint(vfs, template, cache={}):
    """Conservative footprint of a building: (radius, extents) from its exterior floor; None if no layout."""
    if template in cache:
        return cache[template]
    res = None
    try:
        pob = pob_of(vfs, template)
        if pob:
            fl = [f for f in floors_of(vfs, pob) if f[0] == 0]
            if fl:
                e = floor_extents(vfs, fl[0][2])
                res = (max(abs(e["x0"]), abs(e["x1"]), abs(e["z0"]), abs(e["z1"])), e)
    except FileNotFoundError:
        res = None
    cache[template] = res
    return res


def guessed_radius(name):
    if "64x32" in name:
        return 40.0
    if "64x16" in name:
        return 36.0
    return 22.0   # shells without a portal layout (filler buildings)


# ---------------------------------------------------------------- furniture (interior layouts)

APPEARANCE_RE = re.compile(rb"appearance/[\x21-\x7e]+?\.(?:apt|lod|msh|sat|cmp)")


def ilf_of(vfs, template):
    """The building's interior layout file (client-only furniture), or None."""
    for s in iff_strings(vfs.read(template)):
        m = re.search(r"interiorlayout/[\x21-\x7e]+?\.ilf", s)
        if m:
            return m.group(0)
    return None


def read_ilf(vfs, ilf):
    """[(prop template, cell name, x, height, z, yaw degrees)] — NODE chunks: two C strings + a 3x4 matrix."""
    d = vfs.read(ilf)
    out, pos = [], 0
    while pos < len(d):
        tag = d[pos:pos + 4]
        size = struct.unpack(">I", d[pos + 4:pos + 8])[0]
        if tag == b"FORM":
            pos += 12
            continue
        if tag == b"NODE":
            p = d[pos + 8:pos + 8 + size]
            a = p.index(b"\0")
            b = p.index(b"\0", a + 1)
            m = struct.unpack("<12f", p[b + 1:b + 49])
            out.append(dict(template=p[:a].decode(), cell=p[a + 1:b].decode(), x=m[3], h=m[7], z=m[11],
                            yaw=math.degrees(math.atan2(m[2], m[0])) % 360))
        pos += 8 + size
    return out


def prop_box(vfs, template, cache={}):
    """A prop's local bounding box (x0, y0, z0, x1, y1, z1) from the BOX chunk of its mesh/lod; None if not found."""
    if template in cache:
        return cache[template]
    res, seen, queue = None, set(), [template.encode()]
    while queue and res is None:
        f = queue.pop(0)
        if f in seen:
            continue
        seen.add(f)
        try:
            d = vfs.read(f.decode())
        except FileNotFoundError:
            continue
        i = d.find(b"BOX ")
        if i >= 0 and not f.endswith(b".iff"):
            v = struct.unpack("<6f", d[i + 8:i + 32])
            res = (min(v[0], v[3]), min(v[1], v[4]), min(v[2], v[5]), max(v[0], v[3]), max(v[1], v[4]), max(v[2], v[5]))
            break
        queue.extend(APPEARANCE_RE.findall(d))
    cache[template] = res
    return res


def prop_clearance(px, pz, prop, box):
    """Horizontal distance from a point to a prop's (yaw-rotated) footprint box; 0 when inside."""
    if box is None:
        return math.hypot(px - prop["x"], pz - prop["z"]) - 0.5   # unknown shape: half a metre
    a = math.radians(-prop["yaw"])
    dx, dz = px - prop["x"], pz - prop["z"]
    lx = dx * math.cos(a) - dz * math.sin(a)
    lz = dx * math.sin(a) + dz * math.cos(a)
    ox = max(box[0] - lx, 0, lx - box[3])
    oz = max(box[2] - lz, 0, lz - box[5])
    return math.hypot(ox, oz)


def standing_props(vfs, props):
    """Furniture a person can collide with: on the floor, taller than a knee, not rugs/paintings/wall gear."""
    out = []
    for pr in props:
        name = pr["template"].rsplit("/", 1)[-1]
        if any(k in name for k in ("rug_", "painting", "terminal_wall", "lamp_desk", "lamp_tbl", "item_")):
            continue
        box = prop_box(vfs, pr["template"])
        if box is not None and (box[4] - box[1]) < 0.35:
            continue
        out.append((pr, box))
    return out


def cmd_furniture(a):
    vfs = Vfs()
    ilf = ilf_of(vfs, a.template)
    if ilf is None:
        print("no interior layout in %s" % a.template)
        return 1
    print("interior layout %s" % ilf)
    for pr in sorted(read_ilf(vfs, ilf), key=lambda p: (p["cell"], p["template"])):
        if a.room and pr["cell"] != a.room:
            continue
        box = prop_box(vfs, pr["template"])
        ext = "box x %.1f..%.1f z %.1f..%.1f h %.2f" % (box[0], box[3], box[2], box[5], box[4] - box[1]) if box else "(no box)"
        print("%-9s x=%6.2f y=%6.2f floor=%.2f yaw=%3.0f  %-45s %s" % (pr["cell"], pr["x"], pr["z"], pr["h"], pr["yaw"], pr["template"].rsplit("/", 1)[-1], ext))
    return 0


def cmd_check(a):
    """Spots (room, x, y) against the furniture: inside a piece = fail, within --margin of one = warn."""
    vfs = Vfs()
    ilf = ilf_of(vfs, a.template)
    props = standing_props(vfs, read_ilf(vfs, ilf)) if ilf else []
    spots = [tuple(s.split(",")) for s in a.spot]
    if a.lua:
        text = open(a.lua, encoding="utf-8").read()
        for m in re.finditer(r'template\s*=\s*"([^"]+)".*?room\s*=\s*"([^"]+)".*?\bx\s*=\s*(-?[\d.]+).*?\by\s*=\s*(-?[\d.]+)', text):
            spots.append((m.group(2), m.group(3), m.group(4), m.group(1)))
    fails = warns = 0
    for sp in spots:
        room, x, y = sp[0], float(sp[1]), float(sp[2])
        label = sp[3] if len(sp) > 3 else "%s,%s,%s" % (room, sp[1], sp[2])
        near = sorted(((prop_clearance(x, y, pr, box), pr) for pr, box in props if pr["cell"] == room), key=lambda t: t[0])
        if not near:
            print("ok    %-28s %-9s x=%6.1f y=%6.1f  (no furniture in the room)" % (label, room, x, y))
            continue
        dist, pr = near[0]
        verdict = "FAIL" if dist <= a.body else ("warn" if dist < a.margin else "ok")
        fails += verdict == "FAIL"
        warns += verdict == "warn"
        print("%-5s %-28s %-9s x=%6.1f y=%6.1f  nearest %.2f m: %s at %.1f,%.1f" % (verdict, label, room, x, y, dist, pr["template"].rsplit("/", 1)[-1], pr["x"], pr["z"]))
    print("summary spots=%d fail=%d warn=%d" % (len(spots), fails, warns))
    return 1 if fails else 0


# ---------------------------------------------------------------- export (world data for the server)

def lua_str(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def cmd_export(a):
    """Write custom_scripts/fb_world_data.lua: footprints of every building template seen on the planets,
    and rooms + standing furniture for every template with an interior (the site builder's shell catalogue)."""
    vfs = Vfs()
    planets = a.planets.split(",")
    templates = set()
    for planet in planets:
        try:
            for n in read_snapshot(vfs, planet):
                if n["parent"] == 0 and "object/building" in n["name"]:
                    templates.add(n["name"])
        except FileNotFoundError:
            print("no snapshot for %s" % planet, file=sys.stderr)
    out = ["-- GENERATED by tools/lotsurvey export (%s). Do not edit: rerun the export." % ",".join(planets),
           "-- Stock building footprints (exterior floor radius) and, for shells with an interior, their rooms",
           "-- (cell-local x range, y range = mesh z, floor z), so the server can check a lot the way",
           "-- tools/lotsurvey does. The furniture lives in fb_world_furniture.lua (FbWorldData.loadFurniture()).",
           "FbWorldData = FbWorldData or {}", "FbWorldData.footprints = {}", "FbWorldData.shells = {}", "FbWorldData.furniture = FbWorldData.furniture or {}",
           "FbWorldData.furnitureFile = \"../custom_scripts/fb_world_furniture.lua\"",
           "function FbWorldData.loadFurniture()",
           "\tif not FbWorldData.furnitureLoaded then includeFile(FbWorldData.furnitureFile); FbWorldData.furnitureLoaded = true end",
           "\treturn FbWorldData.furniture",
           "end"]
    furn = ["-- GENERATED by tools/lotsurvey export. Standing furniture per shell: { room, x, y, yaw, box x0, box y0, box x1, box y1 }",
            "-- (building-local; furniture is client-only, the server never sees it otherwise). Loaded on demand.",
            "FbWorldData = FbWorldData or {}", "FbWorldData.furniture = FbWorldData.furniture or {}"]
    shells = 0
    for t in sorted(templates):
        fp = footprint(vfs, t)
        radius = fp[0] if fp else guessed_radius(t)
        out.append("FbWorldData.footprints[%s] = %.1f" % (lua_str(t), radius))
        pob = pob_of(vfs, t)
        if pob is None or fp is None:
            continue
        rooms = [(idx, room, floor_extents(vfs, path)) for idx, room, path in floors_of(vfs, pob) if idx > 0]
        if not rooms or len(rooms) > a.max_cells:
            continue
        shells += 1
        e = fp[1]
        lines = ["FbWorldData.shells[%s] = {" % lua_str(t),
                 "\tfootprint = { x0 = %.1f, x1 = %.1f, y0 = %.1f, y1 = %.1f }," % (e["x0"], e["x1"], e["z0"], e["z1"]),
                 "\trooms = {"]
        for idx, room, r in rooms:
            lines.append("\t\t[%s] = { cell = %d, x0 = %.1f, x1 = %.1f, y0 = %.1f, y1 = %.1f, z = %.2f, z1 = %.2f }," % (lua_str(room), idx, r["x0"], r["x1"], r["z0"], r["z1"], r["h0"], r["h1"]))
        lines.append("\t},")
        lines.append("}")
        out.extend(lines)
        ilf = ilf_of(vfs, t)
        try:
            props = standing_props(vfs, read_ilf(vfs, ilf)) if ilf else []
        except FileNotFoundError:
            props = []   # a few templates name a layout file that is not in any archive
        if props:
            furn.append("FbWorldData.furniture[%s] = {" % lua_str(t))
            for pr, box in props:
                b = box if box is not None else (-0.5, 0, -0.5, 0.5, 0, 0.5)
                furn.append("\t{ %s, %.2f, %.2f, %.0f, %.2f, %.2f, %.2f, %.2f }," % (lua_str(pr["cell"]), pr["x"], pr["z"], pr["yaw"], b[0], b[2], b[3], b[5]))
            furn.append("}")
    os.makedirs(os.path.dirname(a.out), exist_ok=True)
    with open(a.out, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    fpath = os.path.join(os.path.dirname(a.out), "fb_world_furniture.lua")
    with open(fpath, "w", encoding="utf-8") as fh:
        fh.write("\n".join(furn) + "\n")
    print("wrote %s: %d footprints, %d shells with rooms; furniture in %s" % (a.out, len(templates), shells, fpath))
    return 0


# ---------------------------------------------------------------- commands

def cmd_near(a):
    vfs = Vfs()
    rows = []
    for n in read_snapshot(vfs, a.planet):
        if n["parent"] != 0:
            continue
        d = math.hypot(n["x"] - a.x, n["y"] - a.y)
        if d <= a.radius and (not a.buildings or "object/building" in n["name"]):
            rows.append((0 if "object/building" in n["name"] else 1, d, n))
    rows.sort(key=lambda r: (r[0], r[1]))
    for kind, d, n in rows:
        print("%6.1f  x=%8.1f y=%8.1f z=%6.1f h=%3.0f  oid=%-8d %s" % (d, n["x"], n["y"], n["z"], n["heading"], n["oid"], n["name"]))
    return 0


def cmd_cells(a):
    vfs = Vfs()
    nodes = read_snapshot(vfs, a.planet)
    best = min((n for n in nodes if n["parent"] == 0 and "object/building" in n["name"]),
               key=lambda n: math.hypot(n["x"] - a.x, n["y"] - a.y))
    print("building oid=%d %s at %.1f,%.1f heading=%.0f" % (best["oid"], best["name"], best["x"], best["y"], best["heading"]))
    for k in sorted((n for n in nodes if n["parent"] == best["oid"]), key=lambda n: n["cell"]):
        print("  cell %d oid=%d" % (k["cell"], k["oid"]))
    return 0


def cmd_footprint(a):
    vfs = Vfs()
    fp = footprint(vfs, a.template)
    if fp is None:
        print("no portal layout / exterior floor for %s (filler shell?)" % a.template)
        return 1
    r, e = fp
    print("local x %.1f..%.1f  z %.1f..%.1f  (radius %.1f)  height %.2f..%.2f" % (e["x0"], e["x1"], e["z0"], e["z1"], r, e["h0"], e["h1"]))
    return 0


def cmd_rooms(a):
    vfs = Vfs()
    pob = pob_of(vfs, a.template)
    if pob is None:
        print("no portal layout in %s" % a.template)
        return 1
    print("portal layout %s" % pob)
    print("%-4s %-10s %-24s %-24s %s" % ("cell", "room", "local x", "local y (mesh z)", "floor z"))
    for idx, room, path in floors_of(vfs, pob):
        e = floor_extents(vfs, path)
        fz = "%.2f" % e["h0"] if abs(e["h1"] - e["h0"]) < 0.05 else "%.2f..%.2f" % (e["h0"], e["h1"])
        print("%-4d %-10s %6.1f .. %6.1f           %6.1f .. %6.1f           %s" % (idx, room, e["x0"], e["x1"], e["z0"], e["z1"], fz))
    print("spawnMobile(planet, template, 0, x, floor_z, y, heading, cellOid); cell 0 is the exterior, cells are 1-based in BuildingObject:getCell")
    return 0


def cmd_lots(a):
    vfs = Vfs()
    if a.template:
        fp = footprint(vfs, a.template)
        if fp is None:
            print("no footprint for %s" % a.template)
            return 1
        e = fp[1]
        half_w, back, front = max(abs(e["x0"]), abs(e["x1"])), -e["z0"], e["z1"]
    else:
        half_w, back, front = a.width / 2, a.back, a.front
    nodes = read_snapshot(vfs, a.planet)
    blds, props = [], []
    for n in nodes:
        if n["parent"] != 0:
            continue
        if "object/building" in n["name"]:
            fp = footprint(vfs, n["name"])
            blds.append((n["x"], n["y"], fp[0] if fp else guessed_radius(n["name"])))
        elif "soundobject" not in n["name"]:
            props.append((n["x"], n["y"]))

    def rect(gx, gy, h):
        r = math.radians(h)
        c, s = math.cos(r), math.sin(r)
        pts = [(-half_w, -back), (half_w, -back), (half_w, front), (-half_w, front)]
        return [(gx + x * c + y * s, gy - x * s + y * c) for x, y in pts]

    def dist(px, py, poly):
        # distance from a point to a convex polygon, 0 inside; winding-agnostic
        pos = neg = 0
        best = 1e9
        for i in range(len(poly)):
            ax, ay = poly[i]
            bx, by = poly[(i + 1) % len(poly)]
            ex, ey = bx - ax, by - ay
            t = max(0, min(1, ((px - ax) * ex + (py - ay) * ey) / (ex * ex + ey * ey)))
            best = min(best, math.hypot(px - (ax + t * ex), py - (ay + t * ey)))
            cross = ex * (py - ay) - ey * (px - ax)
            if cross > 0:
                pos += 1
            elif cross < 0:
                neg += 1
        return 0 if (pos == 0 or neg == 0) else best

    reach = max(half_w, back, front)
    cands = []
    for gx in range(int(a.x - a.radius), int(a.x + a.radius) + 1, a.step):
        for gy in range(int(a.y - a.radius), int(a.y + a.radius) + 1, a.step):
            nb = [b for b in blds if math.hypot(b[0] - gx, b[1] - gy) < reach + b[2] + a.gap]
            npr = [q for q in props if math.hypot(q[0] - gx, q[1] - gy) < reach + a.gap]
            for h in (0, 90, 180, 270):
                poly = rect(gx, gy, h)
                if all(dist(x, y, poly) >= r + a.gap for x, y, r in nb) and all(dist(x, y, poly) >= 4 for x, y in npr):
                    r = math.radians(h)
                    px, py = gx + front * math.sin(r), gy + front * math.cos(r)
                    cands.append((math.hypot(px - a.x, py - a.y), gx, gy, h, px, py))
    cands.sort()
    seen = []
    for d, gx, gy, h, px, py in cands:
        if any(math.hypot(gx - sx, gy - sy) < 12 for sx, sy in seen):
            continue
        seen.append((gx, gy))
        print("entrance %4.0f m from the point: origin x=%d y=%d heading=%d  (entrance side ends at %.0f,%.0f)" % (d, gx, gy, h, px, py))
        if len(seen) >= a.count:
            break
    if not seen:
        print("no clear lot within %d m" % a.radius)
    return 0


